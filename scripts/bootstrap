#!/bin/sh

set -eu

usage() {
  printf 'Usage: %s [--force | --upgrade] [--dry-run] [repository-directory]\n' \
    "$0" >&2
}

managed_stage() {
  praxisbound_destination="$praxisbound_target/$1"
  # Each rename stays on the destination's filesystem, including nested mounts.
  praxisbound_stage="${praxisbound_destination%/*}/.praxisbound-install.$$-${praxisbound_destination##*/}"
}

prepare_managed_file() {
  praxisbound_prepare_source=$1
  praxisbound_prepare_relative=$2
  managed_stage "$praxisbound_prepare_relative"
  if [ -e "$praxisbound_stage" ] || [ -L "$praxisbound_stage" ]; then
    printf 'Refusing existing staging path: %s\n' "$praxisbound_stage" >&2
    return 1
  fi
  # The target is under caller control: record ownership before mkdir so a
  # caught interruption or post-operation failure cannot orphan a new directory.
  praxisbound_prepared="$praxisbound_prepare_relative
$praxisbound_prepared"
  if ! (umask 077 && mkdir "$praxisbound_stage"); then
    printf 'Could not create staging directory: %s\n' "$praxisbound_stage" >&2
    return 1
  fi
  if [ -f "$praxisbound_destination" ]; then
    cp -p "$praxisbound_destination" "$praxisbound_stage/original" || return 1
  fi
  if [ -n "$praxisbound_prepare_source" ]; then
    cp "$praxisbound_prepare_source" "$praxisbound_stage/new" || return 1
  else
    {
      printf 'version=%s\n' "$praxisbound_version"
      printf 'revision=%s\n' "$praxisbound_revision"
    } >"$praxisbound_stage/new" || return 1
  fi
}

finish_install() {
  praxisbound_finish_status=$?
  trap - 0
  trap '' HUP INT TERM
  praxisbound_recovery_failed=0

  if [ "$praxisbound_finish_status" -ne 0 ] && [ "$praxisbound_committed" -eq 0 ]; then
    while IFS= read -r praxisbound_recover_relative; do
      [ -n "$praxisbound_recover_relative" ] || continue
      managed_stage "$praxisbound_recover_relative"
      praxisbound_restored=0
      if [ -f "$praxisbound_stage/original" ]; then
        # Keep the recovery copy even if the restoring rename reports failure
        # after changing the destination.
        if cp -p "$praxisbound_stage/original" "$praxisbound_stage/restore" &&
          mv -f "$praxisbound_stage/restore" "$praxisbound_destination"; then
          praxisbound_restored=1
        fi
      elif rm -f "$praxisbound_destination"; then
        praxisbound_restored=1
      fi
      if [ "$praxisbound_restored" -eq 0 ]; then
        praxisbound_recovery_failed=1
        printf 'UNRESTORED: %s\n' "$praxisbound_destination" >&2
        if [ -f "$praxisbound_stage/original" ]; then
          printf 'Restore %s from %s/original using a temporary copy beside the destination, then rename it.\n' \
            "$praxisbound_destination" "$praxisbound_stage" >&2
        else
          printf 'Restore original absence: remove only %s.\n' "$praxisbound_destination" >&2
        fi
        if [ "$praxisbound_recover_relative" = "$praxisbound_marker_relative" ]; then
          if ! rm -f "$praxisbound_destination"; then
            printf 'Do not trust the adoption marker: remove %s before using this adoption.\n' \
              "$praxisbound_destination" >&2
          fi
        fi
      fi
    done <<EOF
$praxisbound_attempted
EOF
    if [ "$praxisbound_legacy_upgrade" -eq 1 ]; then
      managed_stage "$praxisbound_marker_relative"
      if [ -f "$praxisbound_stage/legacy-original" ]; then
        if ! cp -p "$praxisbound_stage/legacy-original" \
          "$praxisbound_stage/legacy-restore" ||
          ! mv -f "$praxisbound_stage/legacy-restore" \
            "$praxisbound_target/$praxisbound_legacy_marker_relative"; then
          praxisbound_recovery_failed=1
          printf 'UNRESTORED: %s\n' \
            "$praxisbound_target/$praxisbound_legacy_marker_relative" >&2
        fi
      fi
    fi
    if [ "$praxisbound_recovery_failed" -eq 0 ]; then
      printf 'Bootstrap failed; original managed file contents and existence restored.\n' >&2
    fi
  fi

  while IFS= read -r praxisbound_cleanup_relative; do
    [ -n "$praxisbound_cleanup_relative" ] || continue
    managed_stage "$praxisbound_cleanup_relative"
    [ -d "$praxisbound_stage" ] || continue
    if [ "$praxisbound_recovery_failed" -eq 1 ]; then
      printf 'Recovery copies retained: %s\n' "$praxisbound_stage" >&2
    elif ! { rm -f "$praxisbound_stage/new" "$praxisbound_stage/restore" "$praxisbound_stage/original" \
      "$praxisbound_stage/legacy-original" "$praxisbound_stage/legacy-restore" &&
      rmdir "$praxisbound_stage"; }; then
      printf 'Cleanup incomplete: %s; remove this staging directory after checking the managed files.\n' \
        "$praxisbound_stage" >&2
      praxisbound_finish_status=1
    fi
  done <<EOF
$praxisbound_prepared
EOF

  if [ "$praxisbound_finish_status" -ne 0 ] && [ "$praxisbound_recovery_failed" -eq 0 ] &&
    [ "$praxisbound_committed" -eq 0 ]; then
    while IFS= read -r praxisbound_created_relative; do
      [ -n "$praxisbound_created_relative" ] || continue
      if [ -d "$praxisbound_target/$praxisbound_created_relative" ] &&
        ! rmdir "$praxisbound_target/$praxisbound_created_relative"; then
        printf 'Cleanup incomplete: %s; remove only if empty.\n' \
          "$praxisbound_target/$praxisbound_created_relative" >&2
      fi
    done <<EOF
$praxisbound_created_directories
EOF
  fi
  [ "$praxisbound_finish_status" -eq 0 ] || exit 1
}

praxisbound_marker_relative='specs/.praxisbound-adoption'
praxisbound_legacy_marker_relative='specs/.forgeflow-adoption'
praxisbound_cr=$(printf '\r')
praxisbound_tab=$(printf '\t')

trim_trailing_blanks() {
  praxisbound_trimmed=$1

  while :; do
    case "$praxisbound_trimmed" in
      *"$praxisbound_cr") praxisbound_trimmed=${praxisbound_trimmed%"$praxisbound_cr"} ;;
      *"$praxisbound_tab") praxisbound_trimmed=${praxisbound_trimmed%"$praxisbound_tab"} ;;
      *' ') praxisbound_trimmed=${praxisbound_trimmed% } ;;
      *) break ;;
    esac
  done
}

# An inherited Git environment would silently redirect every lookup below at
# another repository, so it is cleared for the duration of the query.
praxisbound_git() {
  (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_CEILING_DIRECTORIES
    git -C "$praxisbound_root" "$@"
  )
}

# The revision is evidence about the snapshot that was copied. Anything this
# checkout cannot prove about itself is recorded as unknown: a work tree with
# uncommitted changes must not claim the bare HEAD SHA, and a state that cannot
# be read is not evidence of a clean tree.
resolve_snapshot_revision() {
  praxisbound_revision='unknown'

  command -v git >/dev/null 2>&1 || return 0

  praxisbound_toplevel=$(praxisbound_git rev-parse --show-toplevel 2>/dev/null) ||
    return 0

  if [ "$praxisbound_toplevel" != "$praxisbound_root" ]; then
    return 0
  fi

  praxisbound_head=$(praxisbound_git rev-parse HEAD 2>/dev/null) || return 0

  praxisbound_status=$(praxisbound_git status --porcelain 2>/dev/null) || return 0

  if [ -n "$praxisbound_status" ]; then
    praxisbound_revision="$praxisbound_head-dirty"
  else
    praxisbound_revision="$praxisbound_head"
  fi
}

praxisbound_force=0
praxisbound_upgrade=0
praxisbound_dry_run=0
praxisbound_target=
praxisbound_target_set=0

while [ "$#" -gt 0 ]; do
  if [ "$praxisbound_target_set" -eq 1 ]; then
    usage
    exit 2
  fi

  case "$1" in
    --force)
      if [ "$praxisbound_force" -eq 1 ] || [ "$praxisbound_upgrade" -eq 1 ]; then
        usage
        exit 2
      fi
      praxisbound_force=1
      ;;
    --upgrade)
      if [ "$praxisbound_upgrade" -eq 1 ] || [ "$praxisbound_force" -eq 1 ]; then
        usage
        exit 2
      fi
      praxisbound_upgrade=1
      ;;
    --dry-run)
      if [ "$praxisbound_dry_run" -eq 1 ]; then
        usage
        exit 2
      fi
      praxisbound_dry_run=1
      ;;
    -*)
      usage
      exit 2
      ;;
    *)
      praxisbound_target=$1
      praxisbound_target_set=1
      ;;
  esac
  shift
done

if [ "$praxisbound_target_set" -eq 0 ]; then
  praxisbound_target=.
fi

if [ ! -d "$praxisbound_target" ]; then
  printf 'Target is not a directory: %s\n' "$praxisbound_target" >&2
  exit 2
fi

praxisbound_target=$(
  cd -P "$praxisbound_target" >/dev/null 2>&1
  pwd
)

praxisbound_script_dir=$(
  cd -P "$(dirname "$0")" >/dev/null 2>&1
  pwd
)
praxisbound_root=$(dirname "$praxisbound_script_dir")
if [ ! -f "$praxisbound_root/VERSION" ]; then
  printf 'PraxisBound VERSION is missing: %s\n' "$praxisbound_root/VERSION" >&2
  exit 1
fi

praxisbound_version=$(sed -n '1p' "$praxisbound_root/VERSION")
trim_trailing_blanks "$praxisbound_version"
praxisbound_version=$praxisbound_trimmed

case "$praxisbound_version" in
  '' | *[!0-9.]*)
    printf 'PraxisBound VERSION is not a protocol version: %s\n' \
      "$praxisbound_root/VERSION" >&2
    exit 1
    ;;
esac

# This source-to-destination manifest belongs solely to installation. It must
# never be read as the repository conformance contract; see
# protocol/repository-contract.md for the required entrypoints.
praxisbound_managed_files='templates/AGENTS.md AGENTS.md
templates/story/story.md specs/stories/_template/story.md
templates/story/acceptance.md specs/stories/_template/acceptance.md
templates/story/task.md specs/stories/_template/task.md
guidance/ENTRY.md guidance/ENTRY.md
guidance/PRINCIPLES.md guidance/PRINCIPLES.md
guidance/DECISIONS.md guidance/DECISIONS.md
guidance/PRACTICES.md guidance/PRACTICES.md'

praxisbound_managed_destinations="AGENTS.md
specs/stories/_template/story.md
specs/stories/_template/acceptance.md
specs/stories/_template/task.md
guidance/ENTRY.md
guidance/PRINCIPLES.md
guidance/DECISIONS.md
guidance/PRACTICES.md
$praxisbound_marker_relative"

# An upgrade moves the templates and the marker only. AGENTS.md and guidance
# become repository-owned once installed, so they leave the managed surface.
praxisbound_upgrade_files='templates/story/story.md specs/stories/_template/story.md
templates/story/acceptance.md specs/stories/_template/acceptance.md
templates/story/task.md specs/stories/_template/task.md'

praxisbound_upgrade_destinations="specs/stories/_template/story.md
specs/stories/_template/acceptance.md
specs/stories/_template/task.md
$praxisbound_marker_relative"

if [ "$praxisbound_upgrade" -eq 1 ]; then
  praxisbound_active_files=$praxisbound_upgrade_files
  praxisbound_active_destinations=$praxisbound_upgrade_destinations
  praxisbound_managed_directories='specs specs/stories specs/stories/_template'
else
  praxisbound_active_files=$praxisbound_managed_files
  praxisbound_active_destinations=$praxisbound_managed_destinations
  praxisbound_managed_directories='specs specs/stories specs/stories/_template guidance'
fi

while IFS=' ' read -r praxisbound_template_relative praxisbound_relative_path; do
  praxisbound_source="$praxisbound_root/$praxisbound_template_relative"

  if [ ! -f "$praxisbound_source" ]; then
    printf 'PraxisBound template is missing: %s\n' "$praxisbound_source" >&2
    exit 1
  fi
done <<EOF
$praxisbound_active_files
EOF

if [ "$praxisbound_upgrade" -eq 1 ] &&
  { [ -L "$praxisbound_target/specs/stories" ] ||
    [ ! -d "$praxisbound_target/specs/stories" ]; }; then
  printf 'No PraxisBound adoption to upgrade: %s\n' \
    "$praxisbound_target/specs/stories" >&2
  printf 'Run a fresh bootstrap before --upgrade.\n' >&2
  exit 1
fi

# A legacy adoption is migration input, not a second current identity.  Refuse
# mixed or unsafe states before staging any owned file.
if [ "$praxisbound_upgrade" -eq 1 ] &&
  { [ -e "$praxisbound_target/$praxisbound_legacy_marker_relative" ] ||
    [ -L "$praxisbound_target/$praxisbound_legacy_marker_relative" ]; }; then
  if [ -e "$praxisbound_target/$praxisbound_marker_relative" ] ||
    [ -L "$praxisbound_target/$praxisbound_marker_relative" ]; then
    printf 'Refusing ambiguous current and legacy adoption markers.\n' >&2
    exit 1
  fi
  if [ -L "$praxisbound_target/$praxisbound_legacy_marker_relative" ] ||
    [ ! -f "$praxisbound_target/$praxisbound_legacy_marker_relative" ] ||
    [ ! -r "$praxisbound_target/$praxisbound_legacy_marker_relative" ] ||
    ! awk '
      { sub(/\r$/, "");
        if (NR == 1 && $0 != "version=0.9.0") bad = 1;
        if (NR == 2) {
          if ($0 !~ /^revision=/) bad = 1;
          value = substr($0, 10);
          if (value != "unknown") {
            sub(/-dirty$/, "", value);
            if ((length(value) != 40 && length(value) != 64) ||
              value ~ /[^a-f0-9]/) bad = 1;
          }
        }
        if (NR > 2) bad = 1
      }
      END { exit (NR == 2 && !bad) ? 0 : 1 }
    ' "$praxisbound_target/$praxisbound_legacy_marker_relative"; then
    printf 'Refusing malformed or unsupported legacy adoption marker.\n' >&2
    exit 1
  fi
  praxisbound_legacy_revision=$(sed -n '2s/^revision=//p' \
    "$praxisbound_target/$praxisbound_legacy_marker_relative" | tr -d '\r')
  praxisbound_legacy_upgrade=1
else
  praxisbound_legacy_upgrade=0
fi

for praxisbound_relative_directory in $praxisbound_managed_directories
do
  praxisbound_directory="$praxisbound_target/$praxisbound_relative_directory"

  if [ -L "$praxisbound_directory" ]; then
    printf 'Refusing managed directory symlink: %s\n' \
      "$praxisbound_directory" >&2
    exit 1
  fi

  if [ -e "$praxisbound_directory" ] && [ ! -d "$praxisbound_directory" ]; then
    printf 'Managed directory path is not a directory: %s\n' \
      "$praxisbound_directory" >&2
    exit 1
  fi
done

while IFS= read -r praxisbound_relative_path; do
  praxisbound_destination="$praxisbound_target/$praxisbound_relative_path"

  if [ -L "$praxisbound_destination" ]; then
    printf 'Refusing managed file symlink: %s\n' \
      "$praxisbound_destination" >&2
    exit 1
  fi

  if [ -e "$praxisbound_destination" ] && [ ! -f "$praxisbound_destination" ]; then
    printf 'Managed file path is not a regular file: %s\n' \
      "$praxisbound_destination" >&2
    exit 1
  fi
done <<EOF
$praxisbound_active_destinations
EOF

if [ "$praxisbound_force" -eq 0 ] && [ "$praxisbound_upgrade" -eq 0 ]; then
  praxisbound_conflicts=

  while IFS= read -r praxisbound_relative_path; do
    if [ -e "$praxisbound_target/$praxisbound_relative_path" ]; then
      praxisbound_conflicts="${praxisbound_conflicts}
  $praxisbound_target/$praxisbound_relative_path"
    fi
  done <<EOF
$praxisbound_active_destinations
EOF

  if [ -n "$praxisbound_conflicts" ]; then
    printf 'Refusing to overwrite existing PraxisBound files:%s\n' \
      "$praxisbound_conflicts" >&2
    printf 'Re-run with --force only if replacing these files is intended.\n' >&2
    exit 1
  fi
fi

if [ "$praxisbound_dry_run" -eq 1 ]; then
  while IFS= read -r praxisbound_relative_path; do
    praxisbound_destination="$praxisbound_target/$praxisbound_relative_path"

    if [ -e "$praxisbound_destination" ]; then
      printf 'Would replace %s\n' "$praxisbound_destination"
    else
      printf 'Would install %s\n' "$praxisbound_destination"
    fi
  done <<EOF
$praxisbound_active_destinations
EOF

  printf 'PraxisBound dry run completed for %s\n' "$praxisbound_target"
  exit 0
fi

praxisbound_previous_version=
if [ "$praxisbound_upgrade" -eq 1 ] &&
  [ -f "$praxisbound_target/$praxisbound_marker_relative" ]; then
  if ! praxisbound_previous_version=$(
    sed -n 's/^version=//p;/^version=/q' \
      "$praxisbound_target/$praxisbound_marker_relative"
  ); then
    printf 'Could not read the adoption marker: %s\n' \
      "$praxisbound_target/$praxisbound_marker_relative" >&2
    exit 1
  fi

  trim_trailing_blanks "$praxisbound_previous_version"
  praxisbound_previous_version=$praxisbound_trimmed
fi

resolve_snapshot_revision
if [ "$praxisbound_legacy_upgrade" -eq 1 ]; then
  praxisbound_revision=$praxisbound_legacy_revision
fi
praxisbound_prepared=
praxisbound_attempted=
praxisbound_created_directories=
praxisbound_committed=0
trap finish_install 0
trap 'exit 1' HUP INT TERM

for praxisbound_relative_directory in $praxisbound_managed_directories
do
  if [ ! -d "$praxisbound_target/$praxisbound_relative_directory" ]; then
    praxisbound_created_directories="$praxisbound_relative_directory
$praxisbound_created_directories"
    mkdir "$praxisbound_target/$praxisbound_relative_directory"
  fi
done

while IFS=' ' read -r praxisbound_template_relative praxisbound_relative_path; do
  if ! prepare_managed_file "$praxisbound_root/$praxisbound_template_relative" "$praxisbound_relative_path"; then
    printf 'Preparation failed: %s\n' "$praxisbound_target/$praxisbound_relative_path" >&2
    exit 1
  fi
done <<EOF
$praxisbound_active_files
EOF
if ! prepare_managed_file '' "$praxisbound_marker_relative"; then
  printf 'Preparation failed: %s\n' "$praxisbound_target/$praxisbound_marker_relative" >&2
  exit 1
fi

while IFS= read -r praxisbound_relative_path; do
  managed_stage "$praxisbound_relative_path"
  # Include the attempted path before rename: a failing command may have written.
  praxisbound_attempted="$praxisbound_relative_path
$praxisbound_attempted"
  if [ "$praxisbound_relative_path" = "$praxisbound_marker_relative" ] &&
    [ "$praxisbound_legacy_upgrade" -eq 1 ]; then
    if ! cp -p "$praxisbound_target/$praxisbound_legacy_marker_relative" \
      "$praxisbound_stage/legacy-original" ||
      ! rm -f "$praxisbound_target/$praxisbound_legacy_marker_relative"; then
      printf 'Legacy marker replacement failed: %s\n' \
        "$praxisbound_target/$praxisbound_legacy_marker_relative" >&2
      exit 1
    fi
  fi
  if ! mv -f "$praxisbound_stage/new" "$praxisbound_destination"; then
    printf 'Replacement failed: %s\n' "$praxisbound_destination" >&2
    exit 1
  fi
done <<EOF
$praxisbound_active_destinations
EOF
trap '' HUP INT TERM
praxisbound_committed=1

# Finish cleanup before printing success. The same handler also runs on errors.
finish_install

if [ "$praxisbound_upgrade" -eq 1 ]; then
  printf 'AGENTS.md and guidance/ were left unchanged; they are owned by this repository.\n'

  if [ -n "$praxisbound_previous_version" ] &&
    [ "$praxisbound_previous_version" != "$praxisbound_version" ]; then
    printf 'WARNING: this adoption last recorded PraxisBound %s and these templates are %s.\n' \
      "$praxisbound_previous_version" "$praxisbound_version" >&2
    printf 'AGENTS.md and guidance/ were not written and may predate either version; see docs/upgrading.md.\n' >&2
  fi

  printf 'PraxisBound templates upgraded in %s\n' "$praxisbound_target"
  exit 0
fi

printf 'PraxisBound initialized in %s\n' "$praxisbound_target"
