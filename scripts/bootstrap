#!/bin/sh

set -eu

usage() {
  printf 'Usage: %s [--force | --upgrade] [--dry-run] [repository-directory]\n' \
    "$0" >&2
}

managed_stage() {
  forgeflow_destination="$forgeflow_target/$1"
  # Each rename stays on the destination's filesystem, including nested mounts.
  forgeflow_stage="${forgeflow_destination%/*}/.forgeflow-install.$$-${forgeflow_destination##*/}"
}

prepare_managed_file() {
  forgeflow_prepare_source=$1
  forgeflow_prepare_relative=$2
  managed_stage "$forgeflow_prepare_relative"
  if [ -e "$forgeflow_stage" ] || [ -L "$forgeflow_stage" ]; then
    printf 'Refusing existing staging path: %s\n' "$forgeflow_stage" >&2
    return 1
  fi
  # The target is under caller control: record ownership before mkdir so a
  # caught interruption or post-operation failure cannot orphan a new directory.
  forgeflow_prepared="$forgeflow_prepare_relative
$forgeflow_prepared"
  if ! (umask 077 && mkdir "$forgeflow_stage"); then
    printf 'Could not create staging directory: %s\n' "$forgeflow_stage" >&2
    return 1
  fi
  if [ -f "$forgeflow_destination" ]; then
    cp -p "$forgeflow_destination" "$forgeflow_stage/original" || return 1
  fi
  if [ -n "$forgeflow_prepare_source" ]; then
    cp "$forgeflow_prepare_source" "$forgeflow_stage/new" || return 1
  else
    {
      printf 'version=%s\n' "$forgeflow_version"
      printf 'revision=%s\n' "$forgeflow_revision"
    } >"$forgeflow_stage/new" || return 1
  fi
}

finish_install() {
  forgeflow_finish_status=$?
  trap - 0
  trap '' HUP INT TERM
  forgeflow_recovery_failed=0

  if [ "$forgeflow_finish_status" -ne 0 ] && [ "$forgeflow_committed" -eq 0 ]; then
    while IFS= read -r forgeflow_recover_relative; do
      [ -n "$forgeflow_recover_relative" ] || continue
      managed_stage "$forgeflow_recover_relative"
      forgeflow_restored=0
      if [ -f "$forgeflow_stage/original" ]; then
        # Keep the recovery copy even if the restoring rename reports failure
        # after changing the destination.
        if cp -p "$forgeflow_stage/original" "$forgeflow_stage/restore" &&
          mv -f "$forgeflow_stage/restore" "$forgeflow_destination"; then
          forgeflow_restored=1
        fi
      elif rm -f "$forgeflow_destination"; then
        forgeflow_restored=1
      fi
      if [ "$forgeflow_restored" -eq 0 ]; then
        forgeflow_recovery_failed=1
        printf 'UNRESTORED: %s\n' "$forgeflow_destination" >&2
        if [ -f "$forgeflow_stage/original" ]; then
          printf 'Restore %s from %s/original using a temporary copy beside the destination, then rename it.\n' \
            "$forgeflow_destination" "$forgeflow_stage" >&2
        else
          printf 'Restore original absence: remove only %s.\n' "$forgeflow_destination" >&2
        fi
        if [ "$forgeflow_recover_relative" = "$forgeflow_marker_relative" ]; then
          if ! rm -f "$forgeflow_destination"; then
            printf 'Do not trust the adoption marker: remove %s before using this adoption.\n' \
              "$forgeflow_destination" >&2
          fi
        fi
      fi
    done <<EOF
$forgeflow_attempted
EOF
    if [ "$forgeflow_recovery_failed" -eq 0 ]; then
      printf 'Bootstrap failed; original managed file contents and existence restored.\n' >&2
    fi
  fi

  while IFS= read -r forgeflow_cleanup_relative; do
    [ -n "$forgeflow_cleanup_relative" ] || continue
    managed_stage "$forgeflow_cleanup_relative"
    [ -d "$forgeflow_stage" ] || continue
    if [ "$forgeflow_recovery_failed" -eq 1 ]; then
      printf 'Recovery copies retained: %s\n' "$forgeflow_stage" >&2
    elif ! { rm -f "$forgeflow_stage/new" "$forgeflow_stage/restore" "$forgeflow_stage/original" &&
      rmdir "$forgeflow_stage"; }; then
      printf 'Cleanup incomplete: %s; remove this staging directory after checking the managed files.\n' \
        "$forgeflow_stage" >&2
      forgeflow_finish_status=1
    fi
  done <<EOF
$forgeflow_prepared
EOF

  if [ "$forgeflow_finish_status" -ne 0 ] && [ "$forgeflow_recovery_failed" -eq 0 ] &&
    [ "$forgeflow_committed" -eq 0 ]; then
    while IFS= read -r forgeflow_created_relative; do
      [ -n "$forgeflow_created_relative" ] || continue
      if [ -d "$forgeflow_target/$forgeflow_created_relative" ] &&
        ! rmdir "$forgeflow_target/$forgeflow_created_relative"; then
        printf 'Cleanup incomplete: %s; remove only if empty.\n' \
          "$forgeflow_target/$forgeflow_created_relative" >&2
      fi
    done <<EOF
$forgeflow_created_directories
EOF
  fi
  [ "$forgeflow_finish_status" -eq 0 ] || exit 1
}

forgeflow_marker_relative='specs/.forgeflow-adoption'
forgeflow_cr=$(printf '\r')
forgeflow_tab=$(printf '\t')

trim_trailing_blanks() {
  forgeflow_trimmed=$1

  while :; do
    case "$forgeflow_trimmed" in
      *"$forgeflow_cr") forgeflow_trimmed=${forgeflow_trimmed%"$forgeflow_cr"} ;;
      *"$forgeflow_tab") forgeflow_trimmed=${forgeflow_trimmed%"$forgeflow_tab"} ;;
      *' ') forgeflow_trimmed=${forgeflow_trimmed% } ;;
      *) break ;;
    esac
  done
}

# An inherited Git environment would silently redirect every lookup below at
# another repository, so it is cleared for the duration of the query.
forgeflow_git() {
  (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR \
      GIT_OBJECT_DIRECTORY GIT_CEILING_DIRECTORIES
    git -C "$forgeflow_root" "$@"
  )
}

# The revision is evidence about the snapshot that was copied. Anything this
# checkout cannot prove about itself is recorded as unknown: a work tree with
# uncommitted changes must not claim the bare HEAD SHA, and a state that cannot
# be read is not evidence of a clean tree.
resolve_snapshot_revision() {
  forgeflow_revision='unknown'

  command -v git >/dev/null 2>&1 || return 0

  forgeflow_toplevel=$(forgeflow_git rev-parse --show-toplevel 2>/dev/null) ||
    return 0

  if [ "$forgeflow_toplevel" != "$forgeflow_root" ]; then
    return 0
  fi

  forgeflow_head=$(forgeflow_git rev-parse HEAD 2>/dev/null) || return 0

  forgeflow_status=$(forgeflow_git status --porcelain 2>/dev/null) || return 0

  if [ -n "$forgeflow_status" ]; then
    forgeflow_revision="$forgeflow_head-dirty"
  else
    forgeflow_revision="$forgeflow_head"
  fi
}

forgeflow_force=0
forgeflow_upgrade=0
forgeflow_dry_run=0
forgeflow_target=
forgeflow_target_set=0

while [ "$#" -gt 0 ]; do
  if [ "$forgeflow_target_set" -eq 1 ]; then
    usage
    exit 2
  fi

  case "$1" in
    --force)
      if [ "$forgeflow_force" -eq 1 ] || [ "$forgeflow_upgrade" -eq 1 ]; then
        usage
        exit 2
      fi
      forgeflow_force=1
      ;;
    --upgrade)
      if [ "$forgeflow_upgrade" -eq 1 ] || [ "$forgeflow_force" -eq 1 ]; then
        usage
        exit 2
      fi
      forgeflow_upgrade=1
      ;;
    --dry-run)
      if [ "$forgeflow_dry_run" -eq 1 ]; then
        usage
        exit 2
      fi
      forgeflow_dry_run=1
      ;;
    -*)
      usage
      exit 2
      ;;
    *)
      forgeflow_target=$1
      forgeflow_target_set=1
      ;;
  esac
  shift
done

if [ "$forgeflow_target_set" -eq 0 ]; then
  forgeflow_target=.
fi

if [ ! -d "$forgeflow_target" ]; then
  printf 'Target is not a directory: %s\n' "$forgeflow_target" >&2
  exit 2
fi

forgeflow_target=$(
  cd -P "$forgeflow_target" >/dev/null 2>&1
  pwd
)

forgeflow_script_dir=$(
  cd -P "$(dirname "$0")" >/dev/null 2>&1
  pwd
)
forgeflow_root=$(dirname "$forgeflow_script_dir")
if [ ! -f "$forgeflow_root/VERSION" ]; then
  printf 'ForgeFlow VERSION is missing: %s\n' "$forgeflow_root/VERSION" >&2
  exit 1
fi

forgeflow_version=$(sed -n '1p' "$forgeflow_root/VERSION")
trim_trailing_blanks "$forgeflow_version"
forgeflow_version=$forgeflow_trimmed

case "$forgeflow_version" in
  '' | *[!0-9.]*)
    printf 'ForgeFlow VERSION is not a protocol version: %s\n' \
      "$forgeflow_root/VERSION" >&2
    exit 1
    ;;
esac

forgeflow_managed_files='templates/AGENTS.md AGENTS.md
templates/story/story.md specs/stories/_template/story.md
templates/story/acceptance.md specs/stories/_template/acceptance.md
templates/story/task.md specs/stories/_template/task.md'

forgeflow_managed_destinations="AGENTS.md
specs/stories/_template/story.md
specs/stories/_template/acceptance.md
specs/stories/_template/task.md
$forgeflow_marker_relative"

# An upgrade moves the templates and the marker only. AGENTS.md is
# repository-owned once installed, so it leaves the managed surface entirely.
forgeflow_upgrade_files='templates/story/story.md specs/stories/_template/story.md
templates/story/acceptance.md specs/stories/_template/acceptance.md
templates/story/task.md specs/stories/_template/task.md'

forgeflow_upgrade_destinations="specs/stories/_template/story.md
specs/stories/_template/acceptance.md
specs/stories/_template/task.md
$forgeflow_marker_relative"

if [ "$forgeflow_upgrade" -eq 1 ]; then
  forgeflow_active_files=$forgeflow_upgrade_files
  forgeflow_active_destinations=$forgeflow_upgrade_destinations
else
  forgeflow_active_files=$forgeflow_managed_files
  forgeflow_active_destinations=$forgeflow_managed_destinations
fi

while IFS=' ' read -r forgeflow_template_relative forgeflow_relative_path; do
  forgeflow_source="$forgeflow_root/$forgeflow_template_relative"

  if [ ! -f "$forgeflow_source" ]; then
    printf 'ForgeFlow template is missing: %s\n' "$forgeflow_source" >&2
    exit 1
  fi
done <<EOF
$forgeflow_active_files
EOF

if [ "$forgeflow_upgrade" -eq 1 ] &&
  { [ -L "$forgeflow_target/specs/stories" ] ||
    [ ! -d "$forgeflow_target/specs/stories" ]; }; then
  printf 'No ForgeFlow adoption to upgrade: %s\n' \
    "$forgeflow_target/specs/stories" >&2
  printf 'Run a fresh bootstrap before --upgrade.\n' >&2
  exit 1
fi

for forgeflow_relative_directory in \
  specs \
  specs/stories \
  specs/stories/_template
do
  forgeflow_directory="$forgeflow_target/$forgeflow_relative_directory"

  if [ -L "$forgeflow_directory" ]; then
    printf 'Refusing managed directory symlink: %s\n' \
      "$forgeflow_directory" >&2
    exit 1
  fi

  if [ -e "$forgeflow_directory" ] && [ ! -d "$forgeflow_directory" ]; then
    printf 'Managed directory path is not a directory: %s\n' \
      "$forgeflow_directory" >&2
    exit 1
  fi
done

while IFS= read -r forgeflow_relative_path; do
  forgeflow_destination="$forgeflow_target/$forgeflow_relative_path"

  if [ -L "$forgeflow_destination" ]; then
    printf 'Refusing managed file symlink: %s\n' \
      "$forgeflow_destination" >&2
    exit 1
  fi

  if [ -e "$forgeflow_destination" ] && [ ! -f "$forgeflow_destination" ]; then
    printf 'Managed file path is not a regular file: %s\n' \
      "$forgeflow_destination" >&2
    exit 1
  fi
done <<EOF
$forgeflow_active_destinations
EOF

if [ "$forgeflow_force" -eq 0 ] && [ "$forgeflow_upgrade" -eq 0 ]; then
  forgeflow_conflicts=

  while IFS= read -r forgeflow_relative_path; do
    if [ -e "$forgeflow_target/$forgeflow_relative_path" ]; then
      forgeflow_conflicts="${forgeflow_conflicts}
  $forgeflow_target/$forgeflow_relative_path"
    fi
  done <<EOF
$forgeflow_active_destinations
EOF

  if [ -n "$forgeflow_conflicts" ]; then
    printf 'Refusing to overwrite existing ForgeFlow files:%s\n' \
      "$forgeflow_conflicts" >&2
    printf 'Re-run with --force only if replacing these files is intended.\n' >&2
    exit 1
  fi
fi

if [ "$forgeflow_dry_run" -eq 1 ]; then
  while IFS= read -r forgeflow_relative_path; do
    forgeflow_destination="$forgeflow_target/$forgeflow_relative_path"

    if [ -e "$forgeflow_destination" ]; then
      printf 'Would replace %s\n' "$forgeflow_destination"
    else
      printf 'Would install %s\n' "$forgeflow_destination"
    fi
  done <<EOF
$forgeflow_active_destinations
EOF

  printf 'ForgeFlow dry run completed for %s\n' "$forgeflow_target"
  exit 0
fi

forgeflow_previous_version=
if [ "$forgeflow_upgrade" -eq 1 ] &&
  [ -f "$forgeflow_target/$forgeflow_marker_relative" ]; then
  if ! forgeflow_previous_version=$(
    sed -n 's/^version=//p;/^version=/q' \
      "$forgeflow_target/$forgeflow_marker_relative"
  ); then
    printf 'Could not read the adoption marker: %s\n' \
      "$forgeflow_target/$forgeflow_marker_relative" >&2
    exit 1
  fi

  trim_trailing_blanks "$forgeflow_previous_version"
  forgeflow_previous_version=$forgeflow_trimmed
fi

resolve_snapshot_revision
forgeflow_prepared=
forgeflow_attempted=
forgeflow_created_directories=
forgeflow_committed=0
trap finish_install 0
trap 'exit 1' HUP INT TERM

for forgeflow_relative_directory in specs specs/stories specs/stories/_template
do
  if [ ! -d "$forgeflow_target/$forgeflow_relative_directory" ]; then
    forgeflow_created_directories="$forgeflow_relative_directory
$forgeflow_created_directories"
    mkdir "$forgeflow_target/$forgeflow_relative_directory"
  fi
done

while IFS=' ' read -r forgeflow_template_relative forgeflow_relative_path; do
  if ! prepare_managed_file "$forgeflow_root/$forgeflow_template_relative" "$forgeflow_relative_path"; then
    printf 'Preparation failed: %s\n' "$forgeflow_target/$forgeflow_relative_path" >&2
    exit 1
  fi
done <<EOF
$forgeflow_active_files
EOF
if ! prepare_managed_file '' "$forgeflow_marker_relative"; then
  printf 'Preparation failed: %s\n' "$forgeflow_target/$forgeflow_marker_relative" >&2
  exit 1
fi

while IFS= read -r forgeflow_relative_path; do
  managed_stage "$forgeflow_relative_path"
  # Include the attempted path before rename: a failing command may have written.
  forgeflow_attempted="$forgeflow_relative_path
$forgeflow_attempted"
  if ! mv -f "$forgeflow_stage/new" "$forgeflow_destination"; then
    printf 'Replacement failed: %s\n' "$forgeflow_destination" >&2
    exit 1
  fi
done <<EOF
$forgeflow_active_destinations
EOF
trap '' HUP INT TERM
forgeflow_committed=1

# Finish cleanup before printing success. The same handler also runs on errors.
finish_install

if [ "$forgeflow_upgrade" -eq 1 ]; then
  printf 'AGENTS.md was left unchanged; it is owned by this repository.\n'

  if [ -n "$forgeflow_previous_version" ] &&
    [ "$forgeflow_previous_version" != "$forgeflow_version" ]; then
    printf 'WARNING: this adoption last recorded ForgeFlow %s and these templates are %s.\n' \
      "$forgeflow_previous_version" "$forgeflow_version" >&2
    printf 'AGENTS.md was not written and may predate either version; see docs/upgrading.md.\n' >&2
  fi

  printf 'ForgeFlow templates upgraded in %s\n' "$forgeflow_target"
  exit 0
fi

printf 'ForgeFlow initialized in %s\n' "$forgeflow_target"
