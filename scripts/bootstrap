#!/bin/sh

set -eu

usage() {
  printf 'Usage: %s [--force] [--dry-run] [repository-directory]\n' "$0" >&2
}

install_managed_file() {
  forgeflow_install_source=$1
  forgeflow_install_destination=$2
  forgeflow_install_parent=$(dirname "$forgeflow_install_destination")
  forgeflow_install_stage="$forgeflow_install_parent/.forgeflow-install.$$"

  if ! (umask 077 && mkdir "$forgeflow_install_stage"); then
    printf 'Could not create staging directory: %s\n' \
      "$forgeflow_install_stage" >&2
    return 1
  fi

  if ! cp "$forgeflow_install_source" \
    "$forgeflow_install_stage/managed-file"; then
    rm -f "$forgeflow_install_stage/managed-file"
    rmdir "$forgeflow_install_stage"
    return 1
  fi

  if ! mv -f "$forgeflow_install_stage/managed-file" \
    "$forgeflow_install_destination"; then
    rm -f "$forgeflow_install_stage/managed-file"
    rmdir "$forgeflow_install_stage"
    return 1
  fi

  rmdir "$forgeflow_install_stage"
}

forgeflow_force=0
forgeflow_dry_run=0
forgeflow_target=
forgeflow_target_set=0

while [ "$#" -gt 0 ]; do
  if [ "$forgeflow_target_set" -eq 1 ]; then
    usage
    exit 2
  fi

  case "$1" in
    --force)
      if [ "$forgeflow_force" -eq 1 ]; then
        usage
        exit 2
      fi
      forgeflow_force=1
      ;;
    --dry-run)
      if [ "$forgeflow_dry_run" -eq 1 ]; then
        usage
        exit 2
      fi
      forgeflow_dry_run=1
      ;;
    -*)
      usage
      exit 2
      ;;
    *)
      forgeflow_target=$1
      forgeflow_target_set=1
      ;;
  esac
  shift
done

if [ "$forgeflow_target_set" -eq 0 ]; then
  forgeflow_target=.
fi

if [ ! -d "$forgeflow_target" ]; then
  printf 'Target is not a directory: %s\n' "$forgeflow_target" >&2
  exit 2
fi

forgeflow_target=$(
  cd -P "$forgeflow_target" >/dev/null 2>&1
  pwd
)

forgeflow_script_dir=$(
  cd -P "$(dirname "$0")" >/dev/null 2>&1
  pwd
)
forgeflow_root=$(dirname "$forgeflow_script_dir")

forgeflow_managed_files='templates/AGENTS.md AGENTS.md
templates/story/story.md specs/stories/_template/story.md
templates/story/acceptance.md specs/stories/_template/acceptance.md
templates/story/task.md specs/stories/_template/task.md'

while IFS=' ' read -r forgeflow_template_relative forgeflow_relative_path; do
  forgeflow_source="$forgeflow_root/$forgeflow_template_relative"

  if [ ! -f "$forgeflow_source" ]; then
    printf 'ForgeFlow template is missing: %s\n' "$forgeflow_source" >&2
    exit 1
  fi
done <<EOF
$forgeflow_managed_files
EOF

for forgeflow_relative_directory in \
  specs \
  specs/stories \
  specs/stories/_template
do
  forgeflow_directory="$forgeflow_target/$forgeflow_relative_directory"

  if [ -L "$forgeflow_directory" ]; then
    printf 'Refusing managed directory symlink: %s\n' \
      "$forgeflow_directory" >&2
    exit 1
  fi

  if [ -e "$forgeflow_directory" ] && [ ! -d "$forgeflow_directory" ]; then
    printf 'Managed directory path is not a directory: %s\n' \
      "$forgeflow_directory" >&2
    exit 1
  fi
done

while IFS=' ' read -r forgeflow_template_relative forgeflow_relative_path; do
  forgeflow_destination="$forgeflow_target/$forgeflow_relative_path"

  if [ -L "$forgeflow_destination" ]; then
    printf 'Refusing managed file symlink: %s\n' \
      "$forgeflow_destination" >&2
    exit 1
  fi

  if [ -e "$forgeflow_destination" ] && [ ! -f "$forgeflow_destination" ]; then
    printf 'Managed file path is not a regular file: %s\n' \
      "$forgeflow_destination" >&2
    exit 1
  fi
done <<EOF
$forgeflow_managed_files
EOF

if [ "$forgeflow_force" -eq 0 ]; then
  forgeflow_conflicts=

  while IFS=' ' read -r forgeflow_template_relative forgeflow_relative_path; do
    if [ -e "$forgeflow_target/$forgeflow_relative_path" ]; then
      forgeflow_conflicts="${forgeflow_conflicts}
  $forgeflow_target/$forgeflow_relative_path"
    fi
  done <<EOF
$forgeflow_managed_files
EOF

  if [ -n "$forgeflow_conflicts" ]; then
    printf 'Refusing to overwrite existing ForgeFlow files:%s\n' \
      "$forgeflow_conflicts" >&2
    printf 'Re-run with --force only if replacing these files is intended.\n' >&2
    exit 1
  fi
fi

if [ "$forgeflow_dry_run" -eq 1 ]; then
  while IFS=' ' read -r forgeflow_template_relative forgeflow_relative_path; do
    forgeflow_destination="$forgeflow_target/$forgeflow_relative_path"

    if [ -e "$forgeflow_destination" ]; then
      printf 'Would replace %s\n' "$forgeflow_destination"
    else
      printf 'Would install %s\n' "$forgeflow_destination"
    fi
  done <<EOF
$forgeflow_managed_files
EOF

  printf 'ForgeFlow dry run completed for %s\n' "$forgeflow_target"
  exit 0
fi

mkdir -p "$forgeflow_target/specs/stories/_template"
while IFS=' ' read -r forgeflow_template_relative forgeflow_relative_path; do
  install_managed_file "$forgeflow_root/$forgeflow_template_relative" \
    "$forgeflow_target/$forgeflow_relative_path"
done <<EOF
$forgeflow_managed_files
EOF

printf 'ForgeFlow initialized in %s\n' "$forgeflow_target"
