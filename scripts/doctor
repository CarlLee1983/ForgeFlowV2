#!/bin/sh

set -eu

usage() {
  printf 'Usage: %s [repository-directory]\n' "$0" >&2
  printf '       %s --run-verify [repository-directory]\n' "$0" >&2
  printf '       %s --help\n' "$0" >&2
}

usage_error() {
  printf 'ERROR Invalid arguments\n' >&2
  usage
  printf '\nResult: ERROR\n' >&2
  printf 'Verification: NOT_RUN\n' >&2
  printf 'CI: NOT_CHECKED\n' >&2
  printf 'Merge policy: NOT_CHECKED\n' >&2
}

help() {
  printf 'PraxisBound Repository Doctor\n\n'
  printf 'Usage: %s [repository-directory]\n' "$0"
  printf '       %s --run-verify [repository-directory]\n' "$0"
  printf '       %s --help\n\n' "$0"
  printf 'Without --run-verify, Doctor performs static, read-only structure checks.\n'
  printf 'Static success does not mean make verify or human review passed.\n\n'
  printf '%s\n' '--run-verify executes repository-owned code and is not read-only or sandboxed.'
  printf 'It may create build files, start services, or use the network.\n'
  printf 'Use it only with repositories you trust.\n'
}

file_has_non_whitespace() {
  praxisbound_content_file=$1

  while IFS= read -r praxisbound_content_line ||
    [ -n "$praxisbound_content_line" ]; do
    case "$praxisbound_content_line" in
      *[![:space:]]*) return 0 ;;
    esac
  done <"$praxisbound_content_file"

  return 1
}

strip_make_blanks() {
  praxisbound_stripped_make_text=$1

  while :; do
    case "$praxisbound_stripped_make_text" in
      ' '*) praxisbound_stripped_make_text=${praxisbound_stripped_make_text# } ;;
      "$praxisbound_tab"*)
        praxisbound_stripped_make_text=${praxisbound_stripped_make_text#"$praxisbound_tab"}
        ;;
      *) break ;;
    esac
  done
}

is_make_define_directive() {
  praxisbound_define_candidate=$1
  praxisbound_seen_override=0
  praxisbound_seen_export=0

  while :; do
    case "$praxisbound_define_candidate" in
      override[[:blank:]]*)
        [ "$praxisbound_seen_override" -eq 0 ] || return 1
        praxisbound_seen_override=1
        praxisbound_define_candidate=${praxisbound_define_candidate#override}
        strip_make_blanks "$praxisbound_define_candidate"
        praxisbound_define_candidate=$praxisbound_stripped_make_text
        ;;
      export[[:blank:]]*)
        [ "$praxisbound_seen_export" -eq 0 ] || return 1
        praxisbound_seen_export=1
        praxisbound_define_candidate=${praxisbound_define_candidate#export}
        strip_make_blanks "$praxisbound_define_candidate"
        praxisbound_define_candidate=$praxisbound_stripped_make_text
        ;;
      *) break ;;
    esac
  done

  case "$praxisbound_define_candidate" in
    define|define[[:blank:]]*) return 0 ;;
  esac

  return 1
}

scan_makefile() {
  praxisbound_scan_file=$1
  praxisbound_literal_verify_rule=0
  praxisbound_complex_makefile=0
  praxisbound_continuation=0
  praxisbound_define_depth=0
  praxisbound_tab=$(printf '\t')

  while IFS= read -r praxisbound_scan_line ||
    [ -n "$praxisbound_scan_line" ]; do
    if [ "$praxisbound_define_depth" -gt 0 ]; then
      while [ "${praxisbound_scan_line# }" != "$praxisbound_scan_line" ]; do
        praxisbound_scan_line=${praxisbound_scan_line# }
      done

      if is_make_define_directive "$praxisbound_scan_line"; then
        praxisbound_define_depth=$((praxisbound_define_depth + 1))
      else
        case "$praxisbound_scan_line" in
          endef|endef[[:blank:]]*)
            praxisbound_define_depth=$((praxisbound_define_depth - 1))
            ;;
        esac
      fi

      praxisbound_complex_makefile=1
      continue
    fi

    praxisbound_next_continuation=0
    case "$praxisbound_scan_line" in
      *\\)
        praxisbound_next_continuation=1
        praxisbound_complex_makefile=1
        ;;
    esac

    if [ "$praxisbound_continuation" -eq 1 ]; then
      praxisbound_continuation=$praxisbound_next_continuation
      continue
    fi
    praxisbound_continuation=$praxisbound_next_continuation

    case "$praxisbound_scan_line" in
      "$praxisbound_tab"*) continue ;;
    esac

    while [ "${praxisbound_scan_line# }" != "$praxisbound_scan_line" ]; do
      praxisbound_scan_line=${praxisbound_scan_line# }
    done

    case "$praxisbound_scan_line" in
      ''|'#'*) continue ;;
      include|-include|sinclude|include\ *|-include\ *|sinclude\ *)
        praxisbound_complex_makefile=1
        ;;
    esac

    if is_make_define_directive "$praxisbound_scan_line"; then
      praxisbound_define_depth=1
      praxisbound_complex_makefile=1
      continue
    fi

    # The quoted dollar signs are literal Make syntax, not shell expansion.
    # shellcheck disable=SC2016
    case "$praxisbound_scan_line" in
      *'$('*|*'${'*) praxisbound_complex_makefile=1 ;;
    esac

    case "$praxisbound_scan_line" in
      verify*)
        praxisbound_verify_suffix=${praxisbound_scan_line#verify}

        while [ "${praxisbound_verify_suffix# }" != \
          "$praxisbound_verify_suffix" ]; do
          praxisbound_verify_suffix=${praxisbound_verify_suffix# }
        done

        case "$praxisbound_verify_suffix" in
          :*)
            praxisbound_verify_suffix=${praxisbound_verify_suffix#:}
            while [ "${praxisbound_verify_suffix#:}" != \
              "$praxisbound_verify_suffix" ]; do
              praxisbound_verify_suffix=${praxisbound_verify_suffix#:}
            done
            case "$praxisbound_verify_suffix" in
              =*) ;;
              *) praxisbound_literal_verify_rule=1 ;;
            esac
            ;;
        esac
        ;;
    esac
  done <"$praxisbound_scan_file"
}

praxisbound_run_verify=0
praxisbound_target=.

case "$#" in
  0) ;;
  1)
    case "$1" in
      --help)
        help
        exit 0
        ;;
      --run-verify) praxisbound_run_verify=1 ;;
      -*)
        usage_error
        exit 2
        ;;
      *) praxisbound_target=$1 ;;
    esac
    ;;
  2)
    if [ "$1" != '--run-verify' ]; then
      usage_error
      exit 2
    fi

    case "$2" in
      -*)
        usage_error
        exit 2
        ;;
      *)
        praxisbound_run_verify=1
        praxisbound_target=$2
        ;;
    esac
    ;;
  *)
    usage_error
    exit 2
    ;;
esac

if [ ! -d "$praxisbound_target" ]; then
  printf 'PraxisBound Doctor\n\n'
  printf 'ERROR Repository is not a directory: %s\n\n' "$praxisbound_target"
  printf 'Result: ERROR\n'
  printf 'Verification: NOT_RUN\n'
  printf 'CI: NOT_CHECKED\n'
  printf 'Merge policy: NOT_CHECKED\n'
  exit 2
fi

if praxisbound_physical_target=$(
  CDPATH='' cd -P "$praxisbound_target" >/dev/null 2>&1 || exit 1
  pwd
); then
  praxisbound_target=$praxisbound_physical_target
else
  printf 'PraxisBound Doctor\n\n'
  printf 'ERROR Repository directory cannot be resolved: %s\n\n' \
    "$praxisbound_target"
  printf 'Result: ERROR\n'
  printf 'Verification: NOT_RUN\n'
  printf 'CI: NOT_CHECKED\n'
  printf 'Merge policy: NOT_CHECKED\n'
  exit 2
fi

# Resolved with shell builtins only: Doctor must behave identically when the
# caller's PATH holds no external utilities.
case "$0" in
  */*) praxisbound_script_dir=${0%/*} ;;
  *) praxisbound_script_dir=. ;;
esac

praxisbound_script_dir=$(
  CDPATH='' cd -P "$praxisbound_script_dir" >/dev/null 2>&1 || exit 1
  pwd
)
praxisbound_root=${praxisbound_script_dir%/*}

if [ -z "$praxisbound_root" ]; then
  praxisbound_root='/'
fi
praxisbound_marker_relative='specs/.praxisbound-adoption'
praxisbound_legacy_marker_relative='specs/.forgeflow-adoption'
praxisbound_cr=$(printf '\r')
praxisbound_tab=$(printf '\t')

trim_trailing_blanks() {
  praxisbound_trimmed=$1

  while :; do
    case "$praxisbound_trimmed" in
      *"$praxisbound_cr") praxisbound_trimmed=${praxisbound_trimmed%"$praxisbound_cr"} ;;
      *"$praxisbound_tab") praxisbound_trimmed=${praxisbound_trimmed%"$praxisbound_tab"} ;;
      *' ') praxisbound_trimmed=${praxisbound_trimmed% } ;;
      *) break ;;
    esac
  done
}

# Read with shell builtins only: static mode must behave identically when the
# caller's PATH holds no external utilities.
read_first_line() {
  praxisbound_first_line=''

  {
    IFS= read -r praxisbound_first_line || [ -n "$praxisbound_first_line" ]
  } <"$1" || return 1

  trim_trailing_blanks "$praxisbound_first_line"
  praxisbound_first_line=$praxisbound_trimmed
}

read_marker_version() {
  praxisbound_marker_version=''

  while IFS= read -r praxisbound_marker_line ||
    [ -n "$praxisbound_marker_line" ]
  do
    case "$praxisbound_marker_line" in
      version=*)
        praxisbound_marker_version=${praxisbound_marker_line#version=}
        trim_trailing_blanks "$praxisbound_marker_version"
        praxisbound_marker_version=$praxisbound_trimmed
        [ -n "$praxisbound_marker_version" ] || return 1
        return 0
        ;;
    esac
  done <"$1"

  return 1
}
praxisbound_adopted_version='UNKNOWN'
praxisbound_story_contract='NOT_CHECKED'
praxisbound_handoff_contract='NOT_CHECKED'
praxisbound_guidance='NOT_CHECKED'
praxisbound_skills='NOT_CHECKED'
praxisbound_ci='NOT_CHECKED'
praxisbound_contract_drift=0
praxisbound_contract_error=0
praxisbound_static_result='STRUCTURE_OK'

# The composed checkers are read-only and are given paths rather than being run
# from inside the target, so static mode never executes repository-owned code.
read_adoption_marker() {
  praxisbound_marker_path="$praxisbound_target/$praxisbound_marker_relative"

  if [ -L "$praxisbound_marker_path" ]; then
    printf 'ERROR Adoption marker is a symlink and cannot be safely read: %s\n' \
      "$praxisbound_marker_relative"
    praxisbound_contract_error=1
    return 0
  fi

  if [ ! -e "$praxisbound_marker_path" ]; then
    printf 'INFO  No adoption marker; the adopted protocol version is unknown\n'
    return 0
  fi

  if [ ! -f "$praxisbound_marker_path" ] || [ ! -r "$praxisbound_marker_path" ]; then
    printf 'ERROR Adoption marker cannot be read: %s\n' \
      "$praxisbound_marker_relative"
    praxisbound_contract_error=1
    return 0
  fi

  if ! read_marker_version "$praxisbound_marker_path"; then
    printf 'ERROR Adoption marker records no version: %s\n' \
      "$praxisbound_marker_relative"
    praxisbound_contract_error=1
    return 0
  fi

  praxisbound_adopted_version=$praxisbound_marker_version

  if [ "$praxisbound_adopted_version" != "$praxisbound_version" ]; then
    printf 'WARN  Adopted version %s differs from this checkout %s\n' \
      "$praxisbound_adopted_version" "$praxisbound_version"
    praxisbound_contract_drift=1
  fi

  if [ -e "$praxisbound_target/$praxisbound_legacy_marker_relative" ] ||
    [ -L "$praxisbound_target/$praxisbound_legacy_marker_relative" ]; then
    printf 'ERROR Current and legacy adoption markers are both present.\n'
    praxisbound_contract_error=1
  fi
}

read_legacy_adoption_marker() {
  praxisbound_marker_path="$praxisbound_target/$praxisbound_legacy_marker_relative"
  [ -e "$praxisbound_marker_path" ] || [ -L "$praxisbound_marker_path" ] || return 0
  if [ -e "$praxisbound_target/$praxisbound_marker_relative" ] ||
    [ -L "$praxisbound_target/$praxisbound_marker_relative" ]; then
    printf 'ERROR Current and legacy adoption markers are both present.\n'
    praxisbound_contract_error=1
    return 0
  fi
  if [ -L "$praxisbound_marker_path" ] || [ ! -f "$praxisbound_marker_path" ] ||
    [ ! -r "$praxisbound_marker_path" ]; then
    printf 'ERROR Legacy adoption marker cannot be safely read: %s\n' "$praxisbound_legacy_marker_relative"
    praxisbound_contract_error=1
    return 0
  fi
  if ! read_marker_version "$praxisbound_marker_path" ||
    [ "$praxisbound_marker_version" != '0.9.0' ]; then
    printf 'ERROR Legacy adoption marker is malformed or unsupported: %s\n' "$praxisbound_legacy_marker_relative"
    praxisbound_contract_error=1
    return 0
  fi
  printf 'WARN  Legacy ForgeFlow adoption requires migration: %s\n' "$praxisbound_legacy_marker_relative"
  praxisbound_contract_drift=1
}

check_story_contract() {
  set --

  for praxisbound_story_entry in "$praxisbound_target"/specs/stories/*
  do
    case "${praxisbound_story_entry##*/}" in
      _template) continue ;;
    esac

    # A dangling symlink fails -e, so the link test comes first.
    if [ -L "$praxisbound_story_entry" ]; then
      printf 'ERROR Story path is a symlink and cannot be safely read: %s\n' \
        "${praxisbound_story_entry##*/}"
      praxisbound_story_contract='ERROR'
      praxisbound_contract_error=1
      return 0
    fi

    [ -e "$praxisbound_story_entry" ] || continue
    [ -d "$praxisbound_story_entry" ] || continue

    set -- "$@" "$praxisbound_story_entry"
  done

  if [ "$#" -eq 0 ]; then
    praxisbound_story_contract='NO_STORIES'
    return 0
  fi

  if "$praxisbound_script_dir/story-check" "$@" >/dev/null 2>&1; then
    praxisbound_story_status=0
  else
    praxisbound_story_status=$?
  fi

  case "$praxisbound_story_status" in
    0) praxisbound_story_contract='STORY_CONTRACT_OK' ;;
    1)
      praxisbound_story_contract='STORY_CONTRACT_INCOMPLETE'
      printf 'WARN  Stories do not satisfy the Story Contract of this checkout\n'
      praxisbound_contract_drift=1
      ;;
    *)
      praxisbound_story_contract='ERROR'
      printf 'ERROR Story contract check could not read the Stories it was given\n'
      praxisbound_contract_error=1
      ;;
  esac
}

check_handoff_contract() {
  praxisbound_handoff_path="$praxisbound_target/specs/handoff.md"

  if [ -L "$praxisbound_handoff_path" ]; then
    printf 'ERROR Handoff is a symlink and cannot be safely read: specs/handoff.md\n'
    praxisbound_contract_error=1
    praxisbound_handoff_contract='ERROR'
    return 0
  fi

  if [ ! -e "$praxisbound_handoff_path" ]; then
    praxisbound_handoff_contract='NOT_PRESENT'
    return 0
  fi

  if "$praxisbound_script_dir/handoff-check" "$praxisbound_handoff_path" \
    >/dev/null 2>&1; then
    praxisbound_handoff_status=0
  else
    praxisbound_handoff_status=$?
  fi

  case "$praxisbound_handoff_status" in
    0) praxisbound_handoff_contract='HANDOFF_CONTRACT_OK' ;;
    1)
      praxisbound_handoff_contract='HANDOFF_CONTRACT_INCOMPLETE'
      printf 'WARN  The handoff does not satisfy the Handoff Contract of this checkout\n'
      praxisbound_contract_drift=1
      ;;
    *)
      praxisbound_handoff_contract='ERROR'
      printf 'ERROR Handoff contract check could not read specs/handoff.md\n'
      praxisbound_contract_error=1
      ;;
  esac
}

check_guidance() {
  praxisbound_guidance_path="$praxisbound_target/guidance"
  praxisbound_guidance='NOT_PRESENT'

  if [ -L "$praxisbound_guidance_path" ]; then
    printf 'ERROR Guidance path is a symlink and cannot be safely read: guidance/\n'
    praxisbound_guidance='ERROR'
    praxisbound_contract_error=1
    return 0
  fi
  if [ ! -e "$praxisbound_guidance_path" ]; then
    printf 'INFO  Guidance capability is not present\n'
    return 0
  fi
  if [ ! -d "$praxisbound_guidance_path" ]; then
    printf 'ERROR Guidance path is not a directory: guidance/\n'
    praxisbound_guidance='ERROR'
    praxisbound_contract_error=1
    return 0
  fi
  if [ ! -r "$praxisbound_guidance_path" ] || [ ! -x "$praxisbound_guidance_path" ]; then
    printf 'ERROR Guidance path cannot be safely read: guidance/\n'
    praxisbound_guidance='ERROR'
    praxisbound_contract_error=1
    return 0
  fi

  praxisbound_guidance_file_path="$praxisbound_guidance_path/ENTRY.md"
  if [ -L "$praxisbound_guidance_file_path" ]; then
    printf 'ERROR Guidance entrypoint is a symlink and cannot be safely read: guidance/ENTRY.md\n'
    praxisbound_guidance='ERROR'
    praxisbound_contract_error=1
  elif [ ! -e "$praxisbound_guidance_file_path" ]; then
    printf 'WARN  Guidance capability is incomplete: guidance/ENTRY.md\n'
    praxisbound_guidance='GUIDANCE_CONTRACT_INCOMPLETE'
    praxisbound_contract_drift=1
  elif [ ! -f "$praxisbound_guidance_file_path" ]; then
    printf 'ERROR Guidance entrypoint is not a regular file: guidance/ENTRY.md\n'
    praxisbound_guidance='ERROR'
    praxisbound_contract_error=1
  elif [ ! -r "$praxisbound_guidance_file_path" ]; then
    printf 'ERROR Guidance entrypoint cannot be safely read: guidance/ENTRY.md\n'
    praxisbound_guidance='ERROR'
    praxisbound_contract_error=1
  elif ! file_has_non_whitespace "$praxisbound_guidance_file_path"; then
    printf 'WARN  Guidance capability is incomplete: guidance/ENTRY.md\n'
    praxisbound_guidance='GUIDANCE_CONTRACT_INCOMPLETE'
    praxisbound_contract_drift=1
  else
    praxisbound_guidance='GUIDANCE_CONTRACT_OK'
    printf 'PASS  Guidance entrypoint: guidance/ENTRY.md\n'
  fi
}

detect_optional_capabilities() {
  if [ -e "$praxisbound_target/skills" ] || [ -L "$praxisbound_target/skills" ] ||
    [ -e "$praxisbound_target/.agents/skills" ] ||
    [ -L "$praxisbound_target/.agents/skills" ]; then
    praxisbound_skills='DETECTED'
  else
    praxisbound_skills='NOT_PRESENT'
  fi

  if [ -e "$praxisbound_target/.github" ] || [ -L "$praxisbound_target/.github" ]; then
    praxisbound_ci='DETECTED'
  else
    praxisbound_ci='NOT_PRESENT'
  fi
}

praxisbound_structure_incomplete=0
praxisbound_structure_error=0
praxisbound_makefile_readable=0
praxisbound_agent_incomplete=0
praxisbound_stories_incomplete=0
praxisbound_makefile_incomplete=0

printf 'PraxisBound Doctor\n\n'

praxisbound_agent_path="$praxisbound_target/AGENTS.md"

if [ -L "$praxisbound_agent_path" ]; then
  printf 'ERROR Required path is a symlink and cannot be safely confirmed: AGENTS.md\n'
  praxisbound_structure_error=1
elif [ ! -e "$praxisbound_agent_path" ]; then
  printf 'FAIL  Agent guide is missing: AGENTS.md\n'
  praxisbound_structure_incomplete=1
  praxisbound_agent_incomplete=1
elif [ ! -f "$praxisbound_agent_path" ]; then
  printf 'FAIL  Agent guide is not a regular file: AGENTS.md\n'
  praxisbound_structure_incomplete=1
  praxisbound_agent_incomplete=1
elif [ ! -r "$praxisbound_agent_path" ]; then
  printf 'ERROR Required path is not readable: AGENTS.md\n'
  praxisbound_structure_error=1
elif ! file_has_non_whitespace "$praxisbound_agent_path"; then
  printf 'FAIL  Agent guide is blank: AGENTS.md\n'
  praxisbound_structure_incomplete=1
  praxisbound_agent_incomplete=1
else
  printf 'PASS  Agent guide: AGENTS.md\n'
fi

praxisbound_specs_path="$praxisbound_target/specs"
praxisbound_stories_path="$praxisbound_specs_path/stories"

if [ -L "$praxisbound_specs_path" ]; then
  printf 'ERROR Required path is a symlink and cannot be safely confirmed: specs/\n'
  praxisbound_structure_error=1
elif [ ! -e "$praxisbound_specs_path" ]; then
  printf 'FAIL  Story directory is missing: specs/stories/\n'
  praxisbound_structure_incomplete=1
  praxisbound_stories_incomplete=1
elif [ ! -d "$praxisbound_specs_path" ]; then
  printf 'FAIL  Story directory parent is not a directory: specs/\n'
  praxisbound_structure_incomplete=1
  praxisbound_stories_incomplete=1
elif [ ! -x "$praxisbound_specs_path" ]; then
  printf 'ERROR Required path is not searchable: specs/\n'
  praxisbound_structure_error=1
elif [ -L "$praxisbound_stories_path" ]; then
  printf 'ERROR Required path is a symlink and cannot be safely confirmed: specs/stories/\n'
  praxisbound_structure_error=1
elif [ ! -e "$praxisbound_stories_path" ]; then
  printf 'FAIL  Story directory is missing: specs/stories/\n'
  praxisbound_structure_incomplete=1
  praxisbound_stories_incomplete=1
elif [ ! -d "$praxisbound_stories_path" ]; then
  printf 'FAIL  Story path is not a directory: specs/stories/\n'
  praxisbound_structure_incomplete=1
  praxisbound_stories_incomplete=1
elif [ ! -r "$praxisbound_stories_path" ] ||
  [ ! -x "$praxisbound_stories_path" ]; then
  printf 'ERROR Required path is not readable: specs/stories/\n'
  praxisbound_structure_error=1
else
  printf 'PASS  Story directory: specs/stories/\n'
fi

praxisbound_makefile_path="$praxisbound_target/Makefile"

if [ -L "$praxisbound_makefile_path" ]; then
  printf 'ERROR Required path is a symlink and cannot be safely confirmed: Makefile\n'
  praxisbound_structure_error=1
elif [ ! -e "$praxisbound_makefile_path" ]; then
  printf 'FAIL  Makefile is missing\n'
  praxisbound_structure_incomplete=1
  praxisbound_makefile_incomplete=1
elif [ ! -f "$praxisbound_makefile_path" ]; then
  printf 'FAIL  Makefile is not a regular file\n'
  praxisbound_structure_incomplete=1
  praxisbound_makefile_incomplete=1
elif [ ! -r "$praxisbound_makefile_path" ]; then
  printf 'ERROR Required path is not readable: Makefile\n'
  praxisbound_structure_error=1
elif ! file_has_non_whitespace "$praxisbound_makefile_path"; then
  printf 'FAIL  Makefile is blank\n'
  praxisbound_structure_incomplete=1
  praxisbound_makefile_incomplete=1
else
  printf 'PASS  Makefile: readable\n'
  praxisbound_makefile_readable=1
fi

if [ "$praxisbound_makefile_readable" -eq 1 ]; then
  scan_makefile "$praxisbound_target/Makefile"

  if [ "$praxisbound_literal_verify_rule" -eq 1 ]; then
    printf 'INFO  Found a literal verify rule; not executed\n'
  else
    printf 'WARN  Verification entrypoint: UNCONFIRMED\n'
    printf 'INFO  Static inspection cannot prove that make verify is absent\n'
  fi

  if [ "$praxisbound_complex_makefile" -eq 1 ]; then
    printf 'WARN  Makefile uses include, continuation, definition, or dynamic syntax; static inspection is limited\n'
  fi
fi

printf '\n'

if [ "$praxisbound_structure_error" -eq 1 ]; then
  printf 'Adopted version: %s\n' "$praxisbound_adopted_version"
  printf 'Story contract: %s\n' "$praxisbound_story_contract"
  printf 'Handoff: %s\n' "$praxisbound_handoff_contract"
  printf 'Guidance: %s\n\n' "$praxisbound_guidance"
  printf 'Skills: %s\n' "$praxisbound_skills"
  printf 'CI capability: %s\n\n' "$praxisbound_ci"
  printf 'Result: ERROR\n'
  printf 'Verification: NOT_RUN\n'
  printf 'CI: NOT_CHECKED\n'
  printf 'Merge policy: NOT_CHECKED\n\n'
  printf 'Next:\n'
  printf 'Review required-path permissions and symlinks, then run Doctor again.\n'

  if [ "$praxisbound_agent_incomplete" -eq 1 ]; then
    printf 'Add a readable, non-blank repository-owned AGENTS.md.\n'
  fi

  if [ "$praxisbound_stories_incomplete" -eq 1 ]; then
    printf 'Create a readable repository-owned specs/stories/ directory.\n'
  fi

  if [ "$praxisbound_makefile_incomplete" -eq 1 ]; then
    printf 'Define a repository-owned Makefile exposing make verify.\n'
  fi

  exit 2
fi

if [ "$praxisbound_structure_incomplete" -eq 1 ]; then
  printf 'Adopted version: %s\n' "$praxisbound_adopted_version"
  printf 'Story contract: %s\n' "$praxisbound_story_contract"
  printf 'Handoff: %s\n' "$praxisbound_handoff_contract"
  printf 'Guidance: %s\n\n' "$praxisbound_guidance"
  printf 'Skills: %s\n' "$praxisbound_skills"
  printf 'CI capability: %s\n\n' "$praxisbound_ci"
  printf 'Result: STRUCTURE_INCOMPLETE\n'
  printf 'Verification: NOT_RUN\n'
  printf 'CI: NOT_CHECKED\n'
  printf 'Merge policy: NOT_CHECKED\n\n'
  printf 'Next:\n'

  if [ "$praxisbound_agent_incomplete" -eq 1 ]; then
    printf 'Add a readable, non-blank repository-owned AGENTS.md.\n'
  fi

  if [ "$praxisbound_stories_incomplete" -eq 1 ]; then
    printf 'Create a readable repository-owned specs/stories/ directory.\n'
  fi

  if [ "$praxisbound_makefile_incomplete" -eq 1 ]; then
    printf 'Define a repository-owned Makefile exposing make verify.\n'
  fi

  exit 1
fi

if [ "$praxisbound_run_verify" -eq 0 ]; then
  praxisbound_installation_incomplete=

  for praxisbound_required_component in \
    "$praxisbound_root/VERSION" \
    "$praxisbound_script_dir/story-check" \
    "$praxisbound_script_dir/handoff-check"
  do
    if [ ! -f "$praxisbound_required_component" ] ||
      [ ! -r "$praxisbound_required_component" ]; then
      praxisbound_installation_incomplete=$praxisbound_required_component
      break
    fi
  done

  if [ -n "$praxisbound_installation_incomplete" ] ||
    ! read_first_line "$praxisbound_root/VERSION"; then
    printf 'ERROR This PraxisBound installation is incomplete: %s\n\n' \
      "${praxisbound_installation_incomplete:-$praxisbound_root/VERSION}"
    printf 'Adopted version: NOT_CHECKED\n'
    printf 'Story contract: NOT_CHECKED\n'
    printf 'Handoff: NOT_CHECKED\n'
    printf 'Guidance: NOT_CHECKED\n\n'
    printf 'Skills: NOT_CHECKED\n'
    printf 'CI capability: NOT_CHECKED\n\n'
    printf 'Result: ERROR\n'
    printf 'Verification: NOT_RUN\n'
    printf 'CI: NOT_CHECKED\n'
    printf 'Merge policy: NOT_CHECKED\n\n'
    printf 'Next:\n'
    printf 'Run Doctor from a complete PraxisBound checkout.\n'
    exit 2
  fi

  praxisbound_version=$praxisbound_first_line

  read_adoption_marker
  read_legacy_adoption_marker
  check_story_contract
  check_handoff_contract
  check_guidance
  detect_optional_capabilities

  printf 'Adopted version: %s\n' "$praxisbound_adopted_version"
  printf 'Story contract: %s\n' "$praxisbound_story_contract"
  printf 'Handoff: %s\n' "$praxisbound_handoff_contract"
  printf 'Guidance: %s\n' "$praxisbound_guidance"
  printf 'Skills: %s\n' "$praxisbound_skills"
  printf 'CI capability: %s\n\n' "$praxisbound_ci"

  if [ "$praxisbound_contract_error" -eq 1 ]; then
    printf 'Result: ERROR\n'
    printf 'Verification: NOT_RUN\n'
    printf 'CI: NOT_CHECKED\n'
    printf 'Merge policy: NOT_CHECKED\n\n'
    printf 'Next:\n'
    printf 'Review the unreadable contract paths, then run Doctor again.\n'
    exit 2
  fi

  if [ "$praxisbound_contract_drift" -eq 1 ]; then
    praxisbound_static_result='CONTRACT_DRIFT'
  else
    praxisbound_static_result='STRUCTURE_OK'
  fi
fi

if [ "$praxisbound_run_verify" -eq 1 ]; then
  if ! CDPATH='' cd "$praxisbound_target"; then
    printf '\nERROR Could not enter repository root: %s\n\n' \
      "$praxisbound_target" >&2
    printf 'Result: ERROR\n'
    printf 'Verification: NOT_RUN\n'
    printf 'CI: NOT_CHECKED\n'
    printf 'Merge policy: NOT_CHECKED\n'
    exit 2
  fi

  if ! command -v make >/dev/null 2>&1; then
    printf 'ERROR make is required for --run-verify but is not available\n\n'
    printf 'Result: ERROR\n'
    printf 'Verification: NOT_RUN\n'
    printf 'CI: NOT_CHECKED\n'
    printf 'Merge policy: NOT_CHECKED\n'
    exit 2
  fi

  printf 'WARNING: --run-verify executes repository-owned code; this is not read-only or sandboxed.\n'
  printf 'Use this mode only with a repository you trust.\n'
  printf 'Running: make verify\n\n'

  if make verify; then
    praxisbound_verify_status=0
  else
    praxisbound_verify_status=$?
  fi

  printf '\n'

  if [ "$praxisbound_verify_status" -eq 0 ]; then
    printf 'Result: VERIFIED_LOCAL\n'
    printf 'Verification: PASS\n'
    printf 'Verification exit: 0\n'
    printf 'CI: NOT_CHECKED\n'
    printf 'Merge policy: NOT_CHECKED\n'
    printf 'Human review is still required.\n'
    exit 0
  fi

  printf 'Result: VERIFICATION_FAILED\n'
  printf 'Verification: FAIL\n'
  printf 'Verification exit: %s\n' "$praxisbound_verify_status"
  printf 'CI: NOT_CHECKED\n'
  printf 'Merge policy: NOT_CHECKED\n'
  printf 'Human review is still required.\n'
  exit 1
fi

printf 'Result: %s\n' "$praxisbound_static_result"
printf 'Verification: NOT_RUN\n'
printf 'CI: NOT_CHECKED\n'
printf 'Merge policy: NOT_CHECKED\n\n'
printf 'Next:\n'

if [ "$praxisbound_static_result" = 'CONTRACT_DRIFT' ]; then
  printf 'Run scripts/story-check and scripts/handoff-check against the\n'
  printf 'repository for the drift detail, then review the repository gate and run:\n'
else
  printf 'Review the repository gate, then run:\n'
fi

printf '  make verify\n'
printf 'from the target repository root.\n'
