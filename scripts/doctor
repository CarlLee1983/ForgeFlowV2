#!/bin/sh

set -eu

usage() {
  printf 'Usage: %s [repository-directory]\n' "$0" >&2
  printf '       %s --run-verify [repository-directory]\n' "$0" >&2
  printf '       %s --help\n' "$0" >&2
}

usage_error() {
  printf 'ERROR Invalid arguments\n' >&2
  usage
  printf '\nResult: ERROR\n' >&2
  printf 'Verification: NOT_RUN\n' >&2
  printf 'CI: NOT_CHECKED\n' >&2
  printf 'Merge policy: NOT_CHECKED\n' >&2
}

help() {
  printf 'ForgeFlow Repository Doctor\n\n'
  printf 'Usage: %s [repository-directory]\n' "$0"
  printf '       %s --run-verify [repository-directory]\n' "$0"
  printf '       %s --help\n\n' "$0"
  printf 'Without --run-verify, Doctor performs static, read-only structure checks.\n'
  printf 'Static success does not mean make verify or human review passed.\n\n'
  printf '%s\n' '--run-verify executes repository-owned code and is not read-only or sandboxed.'
  printf 'It may create build files, start services, or use the network.\n'
  printf 'Use it only with repositories you trust.\n'
}

file_has_non_whitespace() {
  forgeflow_content_file=$1

  while IFS= read -r forgeflow_content_line ||
    [ -n "$forgeflow_content_line" ]; do
    case "$forgeflow_content_line" in
      *[![:space:]]*) return 0 ;;
    esac
  done <"$forgeflow_content_file"

  return 1
}

strip_make_blanks() {
  forgeflow_stripped_make_text=$1

  while :; do
    case "$forgeflow_stripped_make_text" in
      ' '*) forgeflow_stripped_make_text=${forgeflow_stripped_make_text# } ;;
      "$forgeflow_tab"*)
        forgeflow_stripped_make_text=${forgeflow_stripped_make_text#"$forgeflow_tab"}
        ;;
      *) break ;;
    esac
  done
}

is_make_define_directive() {
  forgeflow_define_candidate=$1
  forgeflow_seen_override=0
  forgeflow_seen_export=0

  while :; do
    case "$forgeflow_define_candidate" in
      override[[:blank:]]*)
        [ "$forgeflow_seen_override" -eq 0 ] || return 1
        forgeflow_seen_override=1
        forgeflow_define_candidate=${forgeflow_define_candidate#override}
        strip_make_blanks "$forgeflow_define_candidate"
        forgeflow_define_candidate=$forgeflow_stripped_make_text
        ;;
      export[[:blank:]]*)
        [ "$forgeflow_seen_export" -eq 0 ] || return 1
        forgeflow_seen_export=1
        forgeflow_define_candidate=${forgeflow_define_candidate#export}
        strip_make_blanks "$forgeflow_define_candidate"
        forgeflow_define_candidate=$forgeflow_stripped_make_text
        ;;
      *) break ;;
    esac
  done

  case "$forgeflow_define_candidate" in
    define|define[[:blank:]]*) return 0 ;;
  esac

  return 1
}

scan_makefile() {
  forgeflow_scan_file=$1
  forgeflow_literal_verify_rule=0
  forgeflow_complex_makefile=0
  forgeflow_continuation=0
  forgeflow_define_depth=0
  forgeflow_tab=$(printf '\t')

  while IFS= read -r forgeflow_scan_line ||
    [ -n "$forgeflow_scan_line" ]; do
    if [ "$forgeflow_define_depth" -gt 0 ]; then
      while [ "${forgeflow_scan_line# }" != "$forgeflow_scan_line" ]; do
        forgeflow_scan_line=${forgeflow_scan_line# }
      done

      if is_make_define_directive "$forgeflow_scan_line"; then
        forgeflow_define_depth=$((forgeflow_define_depth + 1))
      else
        case "$forgeflow_scan_line" in
          endef|endef[[:blank:]]*)
            forgeflow_define_depth=$((forgeflow_define_depth - 1))
            ;;
        esac
      fi

      forgeflow_complex_makefile=1
      continue
    fi

    forgeflow_next_continuation=0
    case "$forgeflow_scan_line" in
      *\\)
        forgeflow_next_continuation=1
        forgeflow_complex_makefile=1
        ;;
    esac

    if [ "$forgeflow_continuation" -eq 1 ]; then
      forgeflow_continuation=$forgeflow_next_continuation
      continue
    fi
    forgeflow_continuation=$forgeflow_next_continuation

    case "$forgeflow_scan_line" in
      "$forgeflow_tab"*) continue ;;
    esac

    while [ "${forgeflow_scan_line# }" != "$forgeflow_scan_line" ]; do
      forgeflow_scan_line=${forgeflow_scan_line# }
    done

    case "$forgeflow_scan_line" in
      ''|'#'*) continue ;;
      include|-include|sinclude|include\ *|-include\ *|sinclude\ *)
        forgeflow_complex_makefile=1
        ;;
    esac

    if is_make_define_directive "$forgeflow_scan_line"; then
      forgeflow_define_depth=1
      forgeflow_complex_makefile=1
      continue
    fi

    # The quoted dollar signs are literal Make syntax, not shell expansion.
    # shellcheck disable=SC2016
    case "$forgeflow_scan_line" in
      *'$('*|*'${'*) forgeflow_complex_makefile=1 ;;
    esac

    case "$forgeflow_scan_line" in
      verify*)
        forgeflow_verify_suffix=${forgeflow_scan_line#verify}

        while [ "${forgeflow_verify_suffix# }" != \
          "$forgeflow_verify_suffix" ]; do
          forgeflow_verify_suffix=${forgeflow_verify_suffix# }
        done

        case "$forgeflow_verify_suffix" in
          :*)
            forgeflow_verify_suffix=${forgeflow_verify_suffix#:}
            while [ "${forgeflow_verify_suffix#:}" != \
              "$forgeflow_verify_suffix" ]; do
              forgeflow_verify_suffix=${forgeflow_verify_suffix#:}
            done
            case "$forgeflow_verify_suffix" in
              =*) ;;
              *) forgeflow_literal_verify_rule=1 ;;
            esac
            ;;
        esac
        ;;
    esac
  done <"$forgeflow_scan_file"
}

forgeflow_run_verify=0
forgeflow_target=.

case "$#" in
  0) ;;
  1)
    case "$1" in
      --help)
        help
        exit 0
        ;;
      --run-verify) forgeflow_run_verify=1 ;;
      -*)
        usage_error
        exit 2
        ;;
      *) forgeflow_target=$1 ;;
    esac
    ;;
  2)
    if [ "$1" != '--run-verify' ]; then
      usage_error
      exit 2
    fi

    case "$2" in
      -*)
        usage_error
        exit 2
        ;;
      *)
        forgeflow_run_verify=1
        forgeflow_target=$2
        ;;
    esac
    ;;
  *)
    usage_error
    exit 2
    ;;
esac

if [ ! -d "$forgeflow_target" ]; then
  printf 'ForgeFlow Doctor\n\n'
  printf 'ERROR Repository is not a directory: %s\n\n' "$forgeflow_target"
  printf 'Result: ERROR\n'
  printf 'Verification: NOT_RUN\n'
  printf 'CI: NOT_CHECKED\n'
  printf 'Merge policy: NOT_CHECKED\n'
  exit 2
fi

if forgeflow_physical_target=$(
  CDPATH='' cd -P "$forgeflow_target" >/dev/null 2>&1 || exit 1
  pwd
); then
  forgeflow_target=$forgeflow_physical_target
else
  printf 'ForgeFlow Doctor\n\n'
  printf 'ERROR Repository directory cannot be resolved: %s\n\n' \
    "$forgeflow_target"
  printf 'Result: ERROR\n'
  printf 'Verification: NOT_RUN\n'
  printf 'CI: NOT_CHECKED\n'
  printf 'Merge policy: NOT_CHECKED\n'
  exit 2
fi

# Resolved with shell builtins only: Doctor must behave identically when the
# caller's PATH holds no external utilities.
case "$0" in
  */*) forgeflow_script_dir=${0%/*} ;;
  *) forgeflow_script_dir=. ;;
esac

forgeflow_script_dir=$(
  CDPATH='' cd -P "$forgeflow_script_dir" >/dev/null 2>&1 || exit 1
  pwd
)
forgeflow_root=${forgeflow_script_dir%/*}

if [ -z "$forgeflow_root" ]; then
  forgeflow_root='/'
fi
forgeflow_marker_relative='specs/.forgeflow-adoption'
forgeflow_cr=$(printf '\r')
forgeflow_tab=$(printf '\t')

trim_trailing_blanks() {
  forgeflow_trimmed=$1

  while :; do
    case "$forgeflow_trimmed" in
      *"$forgeflow_cr") forgeflow_trimmed=${forgeflow_trimmed%"$forgeflow_cr"} ;;
      *"$forgeflow_tab") forgeflow_trimmed=${forgeflow_trimmed%"$forgeflow_tab"} ;;
      *' ') forgeflow_trimmed=${forgeflow_trimmed% } ;;
      *) break ;;
    esac
  done
}

# Read with shell builtins only: static mode must behave identically when the
# caller's PATH holds no external utilities.
read_first_line() {
  forgeflow_first_line=''

  {
    IFS= read -r forgeflow_first_line || [ -n "$forgeflow_first_line" ]
  } <"$1" || return 1

  trim_trailing_blanks "$forgeflow_first_line"
  forgeflow_first_line=$forgeflow_trimmed
}

read_marker_version() {
  forgeflow_marker_version=''

  while IFS= read -r forgeflow_marker_line ||
    [ -n "$forgeflow_marker_line" ]
  do
    case "$forgeflow_marker_line" in
      version=*)
        forgeflow_marker_version=${forgeflow_marker_line#version=}
        trim_trailing_blanks "$forgeflow_marker_version"
        forgeflow_marker_version=$forgeflow_trimmed
        [ -n "$forgeflow_marker_version" ] || return 1
        return 0
        ;;
    esac
  done <"$1"

  return 1
}
forgeflow_adopted_version='UNKNOWN'
forgeflow_story_contract='NOT_CHECKED'
forgeflow_handoff_contract='NOT_CHECKED'
forgeflow_contract_drift=0
forgeflow_contract_error=0
forgeflow_static_result='STRUCTURE_OK'

# The composed checkers are read-only and are given paths rather than being run
# from inside the target, so static mode never executes repository-owned code.
read_adoption_marker() {
  forgeflow_marker_path="$forgeflow_target/$forgeflow_marker_relative"

  if [ -L "$forgeflow_marker_path" ]; then
    printf 'ERROR Adoption marker is a symlink and cannot be safely read: %s\n' \
      "$forgeflow_marker_relative"
    forgeflow_contract_error=1
    return 0
  fi

  if [ ! -e "$forgeflow_marker_path" ]; then
    printf 'INFO  No adoption marker; the adopted protocol version is unknown\n'
    return 0
  fi

  if [ ! -f "$forgeflow_marker_path" ] || [ ! -r "$forgeflow_marker_path" ]; then
    printf 'ERROR Adoption marker cannot be read: %s\n' \
      "$forgeflow_marker_relative"
    forgeflow_contract_error=1
    return 0
  fi

  if ! read_marker_version "$forgeflow_marker_path"; then
    printf 'ERROR Adoption marker records no version: %s\n' \
      "$forgeflow_marker_relative"
    forgeflow_contract_error=1
    return 0
  fi

  forgeflow_adopted_version=$forgeflow_marker_version

  if [ "$forgeflow_adopted_version" != "$forgeflow_version" ]; then
    printf 'WARN  Adopted version %s differs from this checkout %s\n' \
      "$forgeflow_adopted_version" "$forgeflow_version"
    forgeflow_contract_drift=1
  fi
}

check_story_contract() {
  set --

  for forgeflow_story_entry in "$forgeflow_target"/specs/stories/*
  do
    case "${forgeflow_story_entry##*/}" in
      _template) continue ;;
    esac

    # A dangling symlink fails -e, so the link test comes first.
    if [ -L "$forgeflow_story_entry" ]; then
      printf 'ERROR Story path is a symlink and cannot be safely read: %s\n' \
        "${forgeflow_story_entry##*/}"
      forgeflow_story_contract='ERROR'
      forgeflow_contract_error=1
      return 0
    fi

    [ -e "$forgeflow_story_entry" ] || continue
    [ -d "$forgeflow_story_entry" ] || continue

    set -- "$@" "$forgeflow_story_entry"
  done

  if [ "$#" -eq 0 ]; then
    forgeflow_story_contract='NO_STORIES'
    return 0
  fi

  if "$forgeflow_script_dir/story-check" "$@" >/dev/null 2>&1; then
    forgeflow_story_status=0
  else
    forgeflow_story_status=$?
  fi

  case "$forgeflow_story_status" in
    0) forgeflow_story_contract='STORY_CONTRACT_OK' ;;
    1)
      forgeflow_story_contract='STORY_CONTRACT_INCOMPLETE'
      printf 'WARN  Stories do not satisfy the Story Contract of this checkout\n'
      forgeflow_contract_drift=1
      ;;
    *)
      forgeflow_story_contract='ERROR'
      printf 'ERROR Story contract check could not read the Stories it was given\n'
      forgeflow_contract_error=1
      ;;
  esac
}

check_handoff_contract() {
  forgeflow_handoff_path="$forgeflow_target/specs/handoff.md"

  if [ -L "$forgeflow_handoff_path" ]; then
    printf 'ERROR Handoff is a symlink and cannot be safely read: specs/handoff.md\n'
    forgeflow_contract_error=1
    forgeflow_handoff_contract='ERROR'
    return 0
  fi

  if [ ! -e "$forgeflow_handoff_path" ]; then
    forgeflow_handoff_contract='NOT_PRESENT'
    return 0
  fi

  if "$forgeflow_script_dir/handoff-check" "$forgeflow_handoff_path" \
    >/dev/null 2>&1; then
    forgeflow_handoff_status=0
  else
    forgeflow_handoff_status=$?
  fi

  case "$forgeflow_handoff_status" in
    0) forgeflow_handoff_contract='HANDOFF_CONTRACT_OK' ;;
    1)
      forgeflow_handoff_contract='HANDOFF_CONTRACT_INCOMPLETE'
      printf 'WARN  The handoff does not satisfy the Handoff Contract of this checkout\n'
      forgeflow_contract_drift=1
      ;;
    *)
      forgeflow_handoff_contract='ERROR'
      printf 'ERROR Handoff contract check could not read specs/handoff.md\n'
      forgeflow_contract_error=1
      ;;
  esac
}

forgeflow_structure_incomplete=0
forgeflow_structure_error=0
forgeflow_makefile_readable=0
forgeflow_agent_incomplete=0
forgeflow_stories_incomplete=0
forgeflow_makefile_incomplete=0

printf 'ForgeFlow Doctor\n\n'

forgeflow_agent_path="$forgeflow_target/AGENTS.md"

if [ -L "$forgeflow_agent_path" ]; then
  printf 'ERROR Required path is a symlink and cannot be safely confirmed: AGENTS.md\n'
  forgeflow_structure_error=1
elif [ ! -e "$forgeflow_agent_path" ]; then
  printf 'FAIL  Agent guide is missing: AGENTS.md\n'
  forgeflow_structure_incomplete=1
  forgeflow_agent_incomplete=1
elif [ ! -f "$forgeflow_agent_path" ]; then
  printf 'FAIL  Agent guide is not a regular file: AGENTS.md\n'
  forgeflow_structure_incomplete=1
  forgeflow_agent_incomplete=1
elif [ ! -r "$forgeflow_agent_path" ]; then
  printf 'ERROR Required path is not readable: AGENTS.md\n'
  forgeflow_structure_error=1
elif ! file_has_non_whitespace "$forgeflow_agent_path"; then
  printf 'FAIL  Agent guide is blank: AGENTS.md\n'
  forgeflow_structure_incomplete=1
  forgeflow_agent_incomplete=1
else
  printf 'PASS  Agent guide: AGENTS.md\n'
fi

forgeflow_specs_path="$forgeflow_target/specs"
forgeflow_stories_path="$forgeflow_specs_path/stories"

if [ -L "$forgeflow_specs_path" ]; then
  printf 'ERROR Required path is a symlink and cannot be safely confirmed: specs/\n'
  forgeflow_structure_error=1
elif [ ! -e "$forgeflow_specs_path" ]; then
  printf 'FAIL  Story directory is missing: specs/stories/\n'
  forgeflow_structure_incomplete=1
  forgeflow_stories_incomplete=1
elif [ ! -d "$forgeflow_specs_path" ]; then
  printf 'FAIL  Story directory parent is not a directory: specs/\n'
  forgeflow_structure_incomplete=1
  forgeflow_stories_incomplete=1
elif [ ! -x "$forgeflow_specs_path" ]; then
  printf 'ERROR Required path is not searchable: specs/\n'
  forgeflow_structure_error=1
elif [ -L "$forgeflow_stories_path" ]; then
  printf 'ERROR Required path is a symlink and cannot be safely confirmed: specs/stories/\n'
  forgeflow_structure_error=1
elif [ ! -e "$forgeflow_stories_path" ]; then
  printf 'FAIL  Story directory is missing: specs/stories/\n'
  forgeflow_structure_incomplete=1
  forgeflow_stories_incomplete=1
elif [ ! -d "$forgeflow_stories_path" ]; then
  printf 'FAIL  Story path is not a directory: specs/stories/\n'
  forgeflow_structure_incomplete=1
  forgeflow_stories_incomplete=1
elif [ ! -r "$forgeflow_stories_path" ] ||
  [ ! -x "$forgeflow_stories_path" ]; then
  printf 'ERROR Required path is not readable: specs/stories/\n'
  forgeflow_structure_error=1
else
  printf 'PASS  Story directory: specs/stories/\n'
fi

forgeflow_makefile_path="$forgeflow_target/Makefile"

if [ -L "$forgeflow_makefile_path" ]; then
  printf 'ERROR Required path is a symlink and cannot be safely confirmed: Makefile\n'
  forgeflow_structure_error=1
elif [ ! -e "$forgeflow_makefile_path" ]; then
  printf 'FAIL  Makefile is missing\n'
  forgeflow_structure_incomplete=1
  forgeflow_makefile_incomplete=1
elif [ ! -f "$forgeflow_makefile_path" ]; then
  printf 'FAIL  Makefile is not a regular file\n'
  forgeflow_structure_incomplete=1
  forgeflow_makefile_incomplete=1
elif [ ! -r "$forgeflow_makefile_path" ]; then
  printf 'ERROR Required path is not readable: Makefile\n'
  forgeflow_structure_error=1
elif ! file_has_non_whitespace "$forgeflow_makefile_path"; then
  printf 'FAIL  Makefile is blank\n'
  forgeflow_structure_incomplete=1
  forgeflow_makefile_incomplete=1
else
  printf 'PASS  Makefile: readable\n'
  forgeflow_makefile_readable=1
fi

if [ "$forgeflow_makefile_readable" -eq 1 ]; then
  scan_makefile "$forgeflow_target/Makefile"

  if [ "$forgeflow_literal_verify_rule" -eq 1 ]; then
    printf 'INFO  Found a literal verify rule; not executed\n'
  else
    printf 'WARN  Verification entrypoint: UNCONFIRMED\n'
    printf 'INFO  Static inspection cannot prove that make verify is absent\n'
  fi

  if [ "$forgeflow_complex_makefile" -eq 1 ]; then
    printf 'WARN  Makefile uses include, continuation, definition, or dynamic syntax; static inspection is limited\n'
  fi
fi

printf 'INFO  Skill installation is optional\n\n'

if [ "$forgeflow_structure_error" -eq 1 ]; then
  printf 'Adopted version: %s\n' "$forgeflow_adopted_version"
  printf 'Story contract: %s\n' "$forgeflow_story_contract"
  printf 'Handoff: %s\n\n' "$forgeflow_handoff_contract"
  printf 'Result: ERROR\n'
  printf 'Verification: NOT_RUN\n'
  printf 'CI: NOT_CHECKED\n'
  printf 'Merge policy: NOT_CHECKED\n\n'
  printf 'Next:\n'
  printf 'Review required-path permissions and symlinks, then run Doctor again.\n'

  if [ "$forgeflow_agent_incomplete" -eq 1 ]; then
    printf 'Add a readable, non-blank repository-owned AGENTS.md.\n'
  fi

  if [ "$forgeflow_stories_incomplete" -eq 1 ]; then
    printf 'Create a readable repository-owned specs/stories/ directory.\n'
  fi

  if [ "$forgeflow_makefile_incomplete" -eq 1 ]; then
    printf 'Define a repository-owned Makefile exposing make verify.\n'
  fi

  exit 2
fi

if [ "$forgeflow_structure_incomplete" -eq 1 ]; then
  printf 'Adopted version: %s\n' "$forgeflow_adopted_version"
  printf 'Story contract: %s\n' "$forgeflow_story_contract"
  printf 'Handoff: %s\n\n' "$forgeflow_handoff_contract"
  printf 'Result: STRUCTURE_INCOMPLETE\n'
  printf 'Verification: NOT_RUN\n'
  printf 'CI: NOT_CHECKED\n'
  printf 'Merge policy: NOT_CHECKED\n\n'
  printf 'Next:\n'

  if [ "$forgeflow_agent_incomplete" -eq 1 ]; then
    printf 'Add a readable, non-blank repository-owned AGENTS.md.\n'
  fi

  if [ "$forgeflow_stories_incomplete" -eq 1 ]; then
    printf 'Create a readable repository-owned specs/stories/ directory.\n'
  fi

  if [ "$forgeflow_makefile_incomplete" -eq 1 ]; then
    printf 'Define a repository-owned Makefile exposing make verify.\n'
  fi

  exit 1
fi

if [ "$forgeflow_run_verify" -eq 0 ]; then
  forgeflow_installation_incomplete=

  for forgeflow_required_component in \
    "$forgeflow_root/VERSION" \
    "$forgeflow_script_dir/story-check" \
    "$forgeflow_script_dir/handoff-check"
  do
    if [ ! -f "$forgeflow_required_component" ] ||
      [ ! -r "$forgeflow_required_component" ]; then
      forgeflow_installation_incomplete=$forgeflow_required_component
      break
    fi
  done

  if [ -n "$forgeflow_installation_incomplete" ] ||
    ! read_first_line "$forgeflow_root/VERSION"; then
    printf 'ERROR This ForgeFlow installation is incomplete: %s\n\n' \
      "${forgeflow_installation_incomplete:-$forgeflow_root/VERSION}"
    printf 'Adopted version: NOT_CHECKED\n'
    printf 'Story contract: NOT_CHECKED\n'
    printf 'Handoff: NOT_CHECKED\n\n'
    printf 'Result: ERROR\n'
    printf 'Verification: NOT_RUN\n'
    printf 'CI: NOT_CHECKED\n'
    printf 'Merge policy: NOT_CHECKED\n\n'
    printf 'Next:\n'
    printf 'Run Doctor from a complete ForgeFlow checkout.\n'
    exit 2
  fi

  forgeflow_version=$forgeflow_first_line

  read_adoption_marker
  check_story_contract
  check_handoff_contract

  printf 'Adopted version: %s\n' "$forgeflow_adopted_version"
  printf 'Story contract: %s\n' "$forgeflow_story_contract"
  printf 'Handoff: %s\n\n' "$forgeflow_handoff_contract"

  if [ "$forgeflow_contract_error" -eq 1 ]; then
    printf 'Result: ERROR\n'
    printf 'Verification: NOT_RUN\n'
    printf 'CI: NOT_CHECKED\n'
    printf 'Merge policy: NOT_CHECKED\n\n'
    printf 'Next:\n'
    printf 'Review the unreadable contract paths, then run Doctor again.\n'
    exit 2
  fi

  if [ "$forgeflow_contract_drift" -eq 1 ]; then
    forgeflow_static_result='CONTRACT_DRIFT'
  else
    forgeflow_static_result='STRUCTURE_OK'
  fi
fi

if [ "$forgeflow_run_verify" -eq 1 ]; then
  if ! CDPATH='' cd "$forgeflow_target"; then
    printf '\nERROR Could not enter repository root: %s\n\n' \
      "$forgeflow_target" >&2
    printf 'Result: ERROR\n'
    printf 'Verification: NOT_RUN\n'
    printf 'CI: NOT_CHECKED\n'
    printf 'Merge policy: NOT_CHECKED\n'
    exit 2
  fi

  if ! command -v make >/dev/null 2>&1; then
    printf 'ERROR make is required for --run-verify but is not available\n\n'
    printf 'Result: ERROR\n'
    printf 'Verification: NOT_RUN\n'
    printf 'CI: NOT_CHECKED\n'
    printf 'Merge policy: NOT_CHECKED\n'
    exit 2
  fi

  printf 'WARNING: --run-verify executes repository-owned code; this is not read-only or sandboxed.\n'
  printf 'Use this mode only with a repository you trust.\n'
  printf 'Running: make verify\n\n'

  if make verify; then
    forgeflow_verify_status=0
  else
    forgeflow_verify_status=$?
  fi

  printf '\n'

  if [ "$forgeflow_verify_status" -eq 0 ]; then
    printf 'Result: VERIFIED_LOCAL\n'
    printf 'Verification: PASS\n'
    printf 'Verification exit: 0\n'
    printf 'CI: NOT_CHECKED\n'
    printf 'Merge policy: NOT_CHECKED\n'
    printf 'Human review is still required.\n'
    exit 0
  fi

  printf 'Result: VERIFICATION_FAILED\n'
  printf 'Verification: FAIL\n'
  printf 'Verification exit: %s\n' "$forgeflow_verify_status"
  printf 'CI: NOT_CHECKED\n'
  printf 'Merge policy: NOT_CHECKED\n'
  printf 'Human review is still required.\n'
  exit 1
fi

printf 'Result: %s\n' "$forgeflow_static_result"
printf 'Verification: NOT_RUN\n'
printf 'CI: NOT_CHECKED\n'
printf 'Merge policy: NOT_CHECKED\n\n'
printf 'Next:\n'

if [ "$forgeflow_static_result" = 'CONTRACT_DRIFT' ]; then
  printf 'Run scripts/story-check and scripts/handoff-check against the\n'
  printf 'repository for the drift detail, then review the repository gate and run:\n'
else
  printf 'Review the repository gate, then run:\n'
fi

printf '  make verify\n'
printf 'from the target repository root.\n'
