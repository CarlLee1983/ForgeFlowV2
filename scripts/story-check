#!/bin/sh

set -eu

usage() {
  printf 'Usage: %s [story-directory ...]\n' "$0" >&2
  printf '       %s --ready [story-directory ...]\n' "$0" >&2
  printf '       %s --help\n' "$0" >&2
}

usage_error() {
  printf 'ERROR Invalid arguments\n' >&2
  usage
  printf '\nResult: ERROR\n'
  printf 'Stories checked: 0\n'
}

help() {
  printf 'ForgeFlow Story Contract Check\n\n'
  printf 'Usage: %s [story-directory ...]\n' "$0"
  printf '       %s --ready [story-directory ...]\n' "$0"
  printf '       %s --help\n\n' "$0"
  printf 'Without arguments, every directory under specs/stories/ except\n'
  printf '_template/ is checked relative to the current directory.\n\n'
  printf 'The check is static and read-only. It never executes repository code\n'
  printf 'and never replaces make verify or human review.\n'
  printf '%s\n' '--ready also checks Goal, Scope, unique nonempty checkbox AC IDs, and Acceptance Evidence.'
  printf 'It checks minimum content, not human-approved READY.\n'
}

forgeflow_trim() {
  forgeflow_trimmed=$1

  while :; do
    case "$forgeflow_trimmed" in
      *"$forgeflow_cr") forgeflow_trimmed=${forgeflow_trimmed%"$forgeflow_cr"} ;;
      *"$forgeflow_tab") forgeflow_trimmed=${forgeflow_trimmed%"$forgeflow_tab"} ;;
      *' ') forgeflow_trimmed=${forgeflow_trimmed% } ;;
      *) break ;;
    esac
  done

  while :; do
    case "$forgeflow_trimmed" in
      "$forgeflow_cr"*) forgeflow_trimmed=${forgeflow_trimmed#"$forgeflow_cr"} ;;
      "$forgeflow_tab"*) forgeflow_trimmed=${forgeflow_trimmed#"$forgeflow_tab"} ;;
      ' '*) forgeflow_trimmed=${forgeflow_trimmed# } ;;
      *) break ;;
    esac
  done
}

# Track the documented Markdown fence subset with shell builtins. The caller
# initializes forgeflow_fence_length=0 before reading a file.
forgeflow_update_fence() {
  forgeflow_fence_line=$1
  forgeflow_fence_changed=0

  if [ "$forgeflow_fence_length" -eq 0 ]; then
    case "$forgeflow_fence_line" in
      '`'*) forgeflow_fence_character='`' ;;
      '~'*) forgeflow_fence_character='~' ;;
      *) return ;;
    esac

    forgeflow_fence_rest=$forgeflow_fence_line
    forgeflow_fence_run=0
    while :; do
      case "$forgeflow_fence_rest" in
        "$forgeflow_fence_character"*)
          forgeflow_fence_rest=${forgeflow_fence_rest#"$forgeflow_fence_character"}
          forgeflow_fence_run=$((forgeflow_fence_run + 1))
          ;;
        *) break ;;
      esac
    done

    if [ "$forgeflow_fence_run" -ge 3 ]; then
      forgeflow_fence_length=$forgeflow_fence_run
      forgeflow_fence_changed=1
    fi
    return
  fi

  case "$forgeflow_fence_line" in
    "$forgeflow_fence_character"*) ;;
    *) return ;;
  esac

  forgeflow_fence_rest=$forgeflow_fence_line
  forgeflow_fence_run=0
  while :; do
    case "$forgeflow_fence_rest" in
      "$forgeflow_fence_character"*)
        forgeflow_fence_rest=${forgeflow_fence_rest#"$forgeflow_fence_character"}
        forgeflow_fence_run=$((forgeflow_fence_run + 1))
        ;;
      *) break ;;
    esac
  done

  if [ "$forgeflow_fence_run" -ge "$forgeflow_fence_length" ] &&
    [ -z "$forgeflow_fence_rest" ]; then
    forgeflow_fence_length=0
    forgeflow_fence_changed=1
  fi
}

# A markdown separator cell: optional spaces, an optional leading colon, one or
# more dashes, an optional trailing colon, optional spaces. Written with shell
# builtins so the verdict cannot depend on the caller's PATH.
forgeflow_is_separator_cell() {
  forgeflow_cell_rest=$1

  while :; do
    case "$forgeflow_cell_rest" in
      ' '*) forgeflow_cell_rest=${forgeflow_cell_rest# } ;;
      *) break ;;
    esac
  done

  case "$forgeflow_cell_rest" in
    :*) forgeflow_cell_rest=${forgeflow_cell_rest#:} ;;
  esac

  case "$forgeflow_cell_rest" in
    -*) ;;
    *) return 1 ;;
  esac

  while :; do
    case "$forgeflow_cell_rest" in
      -*) forgeflow_cell_rest=${forgeflow_cell_rest#-} ;;
      *) break ;;
    esac
  done

  case "$forgeflow_cell_rest" in
    :*) forgeflow_cell_rest=${forgeflow_cell_rest#:} ;;
  esac

  while :; do
    case "$forgeflow_cell_rest" in
      ' '*) forgeflow_cell_rest=${forgeflow_cell_rest# } ;;
      *) break ;;
    esac
  done

  [ -z "$forgeflow_cell_rest" ]
}

forgeflow_is_five_column_separator() {
  case "$1" in
    '|'*) forgeflow_separator_rest=${1#'|'} ;;
    *) return 1 ;;
  esac

  forgeflow_separator_count=0

  while [ -n "$forgeflow_separator_rest" ]; do
    case "$forgeflow_separator_rest" in
      *'|'*) ;;
      *) return 1 ;;
    esac

    forgeflow_separator_cell=${forgeflow_separator_rest%%'|'*}
    forgeflow_separator_rest=${forgeflow_separator_rest#*'|'}

    forgeflow_is_separator_cell "$forgeflow_separator_cell" || return 1

    forgeflow_separator_count=$((forgeflow_separator_count + 1))

    if [ "$forgeflow_separator_count" -gt 5 ]; then
      return 1
    fi
  done

  [ "$forgeflow_separator_count" -eq 5 ]
}

# A quoted literal is the smallest machine-checkable evidence that a fixture
# records an exact value instead of prose such as "no credentials". Empty or
# blank backticks are not evidence.
forgeflow_has_literal() {
  forgeflow_literal_rest=$1

  while :; do
    case "$forgeflow_literal_rest" in
      *'`'*'`'*)
        forgeflow_literal_rest=${forgeflow_literal_rest#*'`'}
        forgeflow_literal_span=${forgeflow_literal_rest%%'`'*}
        forgeflow_literal_rest=${forgeflow_literal_rest#*'`'}

        case "$forgeflow_literal_span" in
          *[![:space:]]*) return 0 ;;
        esac
        ;;
      *) break ;;
    esac
  done

  return 1
}

# A placeholder is an unfilled template cell, not a payload that happens to
# contain angle brackets: `<script>alert(1)</script>` is a real fixture value.
forgeflow_is_placeholder() {
  case "$1" in
    ''|'*'|'-'|TBD|tbd|'N/A'|'n/a') return 0 ;;
    '<'*'>') return 0 ;;
  esac

  return 1
}

forgeflow_report() {
  printf '%s  %s: %s\n' "$1" "$forgeflow_story_label" "$2"
}

forgeflow_story_fail() {
  forgeflow_report 'FAIL' "$1"
  forgeflow_contract_incomplete=$((forgeflow_contract_incomplete + 1))
}

# Reads "* <label>: <value>" lines inside one Markdown section.
forgeflow_read_declaration() {
  forgeflow_declaration_file=$1
  forgeflow_declaration_section=$2
  forgeflow_declaration_label=$3
  forgeflow_declaration_value=
  forgeflow_declaration_count=0
  forgeflow_declaration_in_section=0
  forgeflow_fence_length=0

  while IFS= read -r forgeflow_declaration_line ||
    [ -n "$forgeflow_declaration_line" ]; do
    forgeflow_trim "$forgeflow_declaration_line"
    forgeflow_declaration_line=$forgeflow_trimmed

    forgeflow_update_fence "$forgeflow_declaration_line"
    [ "$forgeflow_fence_changed" -eq 0 ] || continue
    [ "$forgeflow_fence_length" -eq 0 ] || continue

    case "$forgeflow_declaration_line" in
      '#'*)
        if [ "$forgeflow_declaration_line" = "$forgeflow_declaration_section" ]
        then
          forgeflow_declaration_in_section=1
        else
          forgeflow_declaration_in_section=0
        fi
        continue
        ;;
    esac

    [ "$forgeflow_declaration_in_section" -eq 1 ] || continue

    case "$forgeflow_declaration_line" in
      '- '*)
        forgeflow_declaration_line="* ${forgeflow_declaration_line#'- '}"
        ;;
    esac

    case "$forgeflow_declaration_line" in
      "* $forgeflow_declaration_label: "*)
        forgeflow_declaration_count=$((forgeflow_declaration_count + 1))
        forgeflow_declaration_value=${forgeflow_declaration_line#"* $forgeflow_declaration_label: "}
        forgeflow_trim "$forgeflow_declaration_value"
        forgeflow_declaration_value=$forgeflow_trimmed
        ;;
    esac
  done <"$forgeflow_declaration_file"
}

# Counts "* ..." bullets carrying a quoted literal inside one section.
forgeflow_count_literal_bullets() {
  forgeflow_bullet_file=$1
  forgeflow_bullet_section=$2
  forgeflow_bullet_total=0
  forgeflow_bullet_literal=0
  forgeflow_bullet_section_found=0
  forgeflow_bullet_in_section=0
  forgeflow_fence_length=0

  while IFS= read -r forgeflow_bullet_line ||
    [ -n "$forgeflow_bullet_line" ]; do
    forgeflow_trim "$forgeflow_bullet_line"
    forgeflow_bullet_line=$forgeflow_trimmed

    forgeflow_update_fence "$forgeflow_bullet_line"
    [ "$forgeflow_fence_changed" -eq 0 ] || continue
    [ "$forgeflow_fence_length" -eq 0 ] || continue

    case "$forgeflow_bullet_line" in
      '#'*)
        if [ "$forgeflow_bullet_line" = "$forgeflow_bullet_section" ]; then
          forgeflow_bullet_section_found=1
          forgeflow_bullet_in_section=1
        else
          forgeflow_bullet_in_section=0
        fi
        continue
        ;;
    esac

    [ "$forgeflow_bullet_in_section" -eq 1 ] || continue

    case "$forgeflow_bullet_line" in
      '- '*) forgeflow_bullet_line="* ${forgeflow_bullet_line#'- '}" ;;
    esac

    case "$forgeflow_bullet_line" in
      '* '*)
        forgeflow_bullet_value=${forgeflow_bullet_line#'* '}
        forgeflow_trim "$forgeflow_bullet_value"
        forgeflow_bullet_value=$forgeflow_trimmed

        forgeflow_is_placeholder "$forgeflow_bullet_value" && continue

        forgeflow_bullet_total=$((forgeflow_bullet_total + 1))

        if forgeflow_has_literal "$forgeflow_bullet_value"; then
          forgeflow_bullet_literal=$((forgeflow_bullet_literal + 1))
        fi
        ;;
    esac
  done <"$forgeflow_bullet_file"
}

forgeflow_next_cell() {
  forgeflow_cell=

  while :; do
    case "$forgeflow_row" in
      *'|'*)
        forgeflow_cell_prefix=${forgeflow_row%%|*}
        forgeflow_row=${forgeflow_row#*|}
        forgeflow_backslashes=$forgeflow_cell_prefix
        forgeflow_backslash_count=0
        while :; do
          case "$forgeflow_backslashes" in
            *'\')
              forgeflow_backslashes=${forgeflow_backslashes%'\'}
              forgeflow_backslash_count=$((forgeflow_backslash_count + 1))
              ;;
            *) break ;;
          esac
        done
        forgeflow_cell=$forgeflow_cell$forgeflow_cell_prefix
        if [ $((forgeflow_backslash_count % 2)) -eq 1 ]; then
          forgeflow_cell=$forgeflow_cell'|'
        else
          break
        fi
        ;;
      *)
        forgeflow_cell=$forgeflow_cell$forgeflow_row
        forgeflow_row=
        break
        ;;
    esac
  done

  forgeflow_trim "$forgeflow_cell"
  forgeflow_cell=$forgeflow_trimmed
}

forgeflow_count_pipes() {
  forgeflow_pipe_rest=$1
  forgeflow_pipe_count=0

  while :; do
    case "$forgeflow_pipe_rest" in
      *'|'*)
        forgeflow_pipe_prefix=${forgeflow_pipe_rest%%|*}
        forgeflow_pipe_rest=${forgeflow_pipe_rest#*|}
        forgeflow_backslashes=$forgeflow_pipe_prefix
        forgeflow_backslash_count=0
        while :; do
          case "$forgeflow_backslashes" in
            *'\')
              forgeflow_backslashes=${forgeflow_backslashes%'\'}
              forgeflow_backslash_count=$((forgeflow_backslash_count + 1))
              ;;
            *) break ;;
          esac
        done
        if [ $((forgeflow_backslash_count % 2)) -eq 0 ]; then
          forgeflow_pipe_count=$((forgeflow_pipe_count + 1))
        fi
        ;;
      *) break ;;
    esac
  done
}

forgeflow_check_matrix_row() {
  forgeflow_row=$1
  forgeflow_row_number=$2

  forgeflow_count_pipes "$forgeflow_row"

  if [ "$forgeflow_pipe_count" -ne 6 ]; then
    forgeflow_story_fail "security fixture row $forgeflow_row_number must declare five columns"
    return
  fi

  forgeflow_row=${forgeflow_row#|}

  forgeflow_next_cell
  forgeflow_source_field=$forgeflow_cell
  forgeflow_next_cell
  forgeflow_payload=$forgeflow_cell
  forgeflow_next_cell
  forgeflow_expected=$forgeflow_cell
  forgeflow_next_cell
  forgeflow_locations=$forgeflow_cell
  forgeflow_next_cell
  forgeflow_verification=$forgeflow_cell

  for forgeflow_required_literal_column in \
    "source field=$forgeflow_source_field" \
    "payload=$forgeflow_payload" \
    "persisted locations=$forgeflow_locations" \
    "verification=$forgeflow_verification"
  do
    forgeflow_column_name=${forgeflow_required_literal_column%%=*}
    forgeflow_column_value=${forgeflow_required_literal_column#*=}

    if forgeflow_is_placeholder "$forgeflow_column_value"; then
      forgeflow_story_fail "security fixture row $forgeflow_row_number leaves $forgeflow_column_name unspecified"
      continue
    fi

    if ! forgeflow_has_literal "$forgeflow_column_value"; then
      forgeflow_story_fail "security fixture row $forgeflow_row_number states $forgeflow_column_name as prose instead of an exact value"
    fi
  done

  case "$forgeflow_expected" in
    preserve|redact|reject|omit) ;;
    *)
      forgeflow_story_fail "security fixture row $forgeflow_row_number expected result must be preserve, redact, reject, or omit"
      ;;
  esac
}

forgeflow_check_matrix() {
  forgeflow_matrix_file=$1
  forgeflow_matrix_found=0
  forgeflow_matrix_header=0
  forgeflow_matrix_separator=0
  forgeflow_matrix_rows=0
  forgeflow_matrix_in_section=0
  forgeflow_matrix_row_number=0
  forgeflow_fence_length=0

  while IFS= read -r forgeflow_matrix_line ||
    [ -n "$forgeflow_matrix_line" ]; do
    forgeflow_trim "$forgeflow_matrix_line"
    forgeflow_matrix_line=$forgeflow_trimmed

    forgeflow_update_fence "$forgeflow_matrix_line"
    [ "$forgeflow_fence_changed" -eq 0 ] || continue
    [ "$forgeflow_fence_length" -eq 0 ] || continue

    case "$forgeflow_matrix_line" in
      '#'*)
        if [ "$forgeflow_matrix_line" = '## Security Fixture Matrix' ]; then
          forgeflow_matrix_found=1
          forgeflow_matrix_in_section=1
        else
          forgeflow_matrix_in_section=0
        fi
        continue
        ;;
    esac

    [ "$forgeflow_matrix_in_section" -eq 1 ] || continue

    case "$forgeflow_matrix_line" in
      '|'*)
        if [ "$forgeflow_matrix_header" -eq 0 ]; then
          if [ "$forgeflow_matrix_line" = "$forgeflow_matrix_header_row" ]; then
            forgeflow_matrix_header=1
          else
            forgeflow_story_fail 'security fixture matrix header must be exactly the documented five columns'
            forgeflow_matrix_header=1
          fi
          continue
        fi

        if [ "$forgeflow_matrix_separator" -eq 0 ]; then
          forgeflow_matrix_separator=1

          forgeflow_is_five_column_separator "$forgeflow_matrix_line" ||
            forgeflow_story_fail 'security fixture matrix header must be followed by a five-column separator row'

          continue
        fi

        forgeflow_matrix_row_number=$((forgeflow_matrix_row_number + 1))
        forgeflow_matrix_rows=$((forgeflow_matrix_rows + 1))
        forgeflow_check_matrix_row \
          "$forgeflow_matrix_line" "$forgeflow_matrix_row_number"
        ;;
    esac
  done <"$forgeflow_matrix_file"
}

# Unlike matrix placeholders, readiness uses a finite list, not an angle-bracket
# pattern: technical requirements such as <T> are valid content.
forgeflow_ready_content() {
  forgeflow_trim "$1"
  case "$forgeflow_trimmed" in
    '* '*|'- '*) forgeflow_trim "${forgeflow_trimmed#??}" ;;
  esac
  case "$forgeflow_trimmed" in
    ''|'*'|'-'|TBD|tbd|TODO|todo|'N/A'|'n/a'|'...'|'<goal>'|'<scope>'|\
    '<acceptance criterion>'|'Describe the user or business outcome.') return 1 ;;
  esac
  return 0
}

forgeflow_ready_fail() {
  forgeflow_report 'FAIL' "readiness: $1"
  forgeflow_readiness_incomplete=$((forgeflow_readiness_incomplete + 1))
}

forgeflow_is_exact_literal() {
  forgeflow_exact_literal=$1
  forgeflow_trim "$forgeflow_exact_literal"
  forgeflow_exact_literal=$forgeflow_trimmed

  case "$forgeflow_exact_literal" in
    \`*\`) ;;
    *) return 1 ;;
  esac

  forgeflow_exact_literal=${forgeflow_exact_literal#\`}
  forgeflow_exact_literal=${forgeflow_exact_literal%\`}
  case "$forgeflow_exact_literal" in
    ''|*'`'*) return 1 ;;
    *[![:space:]]*) ;;
    *) return 1 ;;
  esac

  forgeflow_is_evidence_placeholder "$forgeflow_exact_literal" && return 1
  return 0
}

forgeflow_is_evidence_placeholder() {
  case "$1" in
    ''|'*'|'-'|TBD|tbd|TODO|todo|'N/A'|'n/a'|'...'|'<evidence>'|'<fixture>'|\
    '<fixture / precondition>'|'<expected observation>') return 0 ;;
  esac
  return 1
}

forgeflow_check_acceptance_evidence_row() {
  forgeflow_row=$1
  forgeflow_row_number=$2
  forgeflow_count_pipes "$forgeflow_row"
  if [ "$forgeflow_pipe_count" -ne 6 ]; then
    forgeflow_ready_fail "acceptance evidence row $forgeflow_row_number must declare five columns"
    return
  fi

  forgeflow_row=${forgeflow_row#|}
  forgeflow_next_cell
  forgeflow_evidence_ac_cell=$forgeflow_cell
  forgeflow_next_cell
  forgeflow_evidence_method=$forgeflow_cell
  forgeflow_next_cell
  forgeflow_evidence_value=$forgeflow_cell
  forgeflow_next_cell
  forgeflow_evidence_fixture=$forgeflow_cell
  forgeflow_next_cell
  forgeflow_evidence_observation=$forgeflow_cell

  if [ -n "$forgeflow_row" ]; then
    forgeflow_ready_fail "acceptance evidence row $forgeflow_row_number must end after the fifth column"
    return
  fi

  forgeflow_evidence_ac_id=
  case "$forgeflow_evidence_ac_cell" in
    \`AC-*\`)
      forgeflow_evidence_ac_id=${forgeflow_evidence_ac_cell#\`}
      forgeflow_evidence_ac_id=${forgeflow_evidence_ac_id%\`}
      case "${forgeflow_evidence_ac_id#AC-}" in
        ''|*[!0-9]*) forgeflow_evidence_ac_id= ;;
      esac
      ;;
  esac
  if [ -z "$forgeflow_evidence_ac_id" ] ||
    [ "$forgeflow_evidence_ac_cell" != "\`$forgeflow_evidence_ac_id\`" ]; then
    forgeflow_ready_fail "acceptance evidence row $forgeflow_row_number must name one exact backticked AC-<digits> ID"
  else
    case "$forgeflow_ac_ids" in
      *" $forgeflow_evidence_ac_id "*) ;;
      *) forgeflow_ready_fail "acceptance evidence row $forgeflow_row_number names unknown AC ID: $forgeflow_evidence_ac_id" ;;
    esac
    case "$forgeflow_evidence_ids" in
      *" $forgeflow_evidence_ac_id "*) forgeflow_ready_fail "acceptance evidence duplicates AC ID: $forgeflow_evidence_ac_id" ;;
    esac
    forgeflow_evidence_ids="$forgeflow_evidence_ids$forgeflow_evidence_ac_id "
  fi

  case "$forgeflow_evidence_method" in
    test|command|human) ;;
    *) forgeflow_ready_fail "acceptance evidence row $forgeflow_row_number method must be test, command, or human" ;;
  esac

  for forgeflow_evidence_required in \
    "evidence=$forgeflow_evidence_value" \
    "fixture / precondition=$forgeflow_evidence_fixture" \
    "expected observation=$forgeflow_evidence_observation"
  do
    forgeflow_evidence_column=${forgeflow_evidence_required%%=*}
    forgeflow_evidence_cell=${forgeflow_evidence_required#*=}
    if forgeflow_is_evidence_placeholder "$forgeflow_evidence_cell"; then
      forgeflow_ready_fail "acceptance evidence row $forgeflow_row_number leaves $forgeflow_evidence_column unspecified"
    elif ! forgeflow_is_exact_literal "$forgeflow_evidence_cell"; then
      forgeflow_ready_fail "acceptance evidence row $forgeflow_row_number must give $forgeflow_evidence_column as one exact backticked value"
    fi
  done
}

forgeflow_check_acceptance_evidence() {
  forgeflow_evidence_found=0
  forgeflow_evidence_header=0
  forgeflow_evidence_separator=0
  forgeflow_evidence_rows=0
  forgeflow_evidence_in_section=0
  forgeflow_evidence_row_number=0
  forgeflow_evidence_ids=' '
  forgeflow_fence_length=0

  while IFS= read -r forgeflow_evidence_line || [ -n "$forgeflow_evidence_line" ]; do
    forgeflow_trim "$forgeflow_evidence_line"
    forgeflow_evidence_line=$forgeflow_trimmed
    forgeflow_update_fence "$forgeflow_evidence_line"
    [ "$forgeflow_fence_changed" -eq 0 ] || continue
    [ "$forgeflow_fence_length" -eq 0 ] || continue
    case "$forgeflow_evidence_line" in
      '#'* )
        if [ "$forgeflow_evidence_line" = '## Acceptance Evidence' ]; then
          forgeflow_evidence_found=$((forgeflow_evidence_found + 1))
          forgeflow_evidence_in_section=1
        else
          forgeflow_evidence_in_section=0
        fi
        continue
        ;;
    esac
    [ "$forgeflow_evidence_in_section" -eq 1 ] || continue
    case "$forgeflow_evidence_line" in
      '|'*)
        if [ "$forgeflow_evidence_header" -eq 0 ]; then
          if [ "$forgeflow_evidence_line" != "$forgeflow_evidence_header_row" ]; then
            forgeflow_ready_fail 'acceptance evidence header must be exactly the documented five columns'
          fi
          forgeflow_evidence_header=1
          continue
        fi
        if [ "$forgeflow_evidence_separator" -eq 0 ]; then
          forgeflow_evidence_separator=1
          forgeflow_is_five_column_separator "$forgeflow_evidence_line" ||
            forgeflow_ready_fail 'acceptance evidence header must be followed by a five-column separator row'
          continue
        fi
        forgeflow_evidence_row_number=$((forgeflow_evidence_row_number + 1))
        forgeflow_evidence_rows=$((forgeflow_evidence_rows + 1))
        forgeflow_check_acceptance_evidence_row \
          "$forgeflow_evidence_line" "$forgeflow_evidence_row_number"
        ;;
    esac
  done <"$forgeflow_acceptance_file"

  if [ "$forgeflow_evidence_found" -eq 0 ]; then
    forgeflow_ready_fail 'acceptance.md is missing ## Acceptance Evidence'
  elif [ "$forgeflow_evidence_found" -ne 1 ]; then
    forgeflow_ready_fail 'acceptance.md must declare ## Acceptance Evidence exactly once'
  elif [ "$forgeflow_evidence_rows" -eq 0 ]; then
    forgeflow_ready_fail 'acceptance evidence declares no rows'
  fi

  for forgeflow_evidence_required_ac in $forgeflow_ac_ids
  do
    case "$forgeflow_evidence_ids" in
      *" $forgeflow_evidence_required_ac "*) ;;
      *) forgeflow_ready_fail "acceptance evidence is missing AC ID: $forgeflow_evidence_required_ac" ;;
    esac
  done
}

forgeflow_check_readiness() {
  forgeflow_ready_section=
  forgeflow_goal_content=0
  forgeflow_scope_content=0
  forgeflow_fence_length=0
  while IFS= read -r forgeflow_ready_line || [ -n "$forgeflow_ready_line" ]; do
    forgeflow_trim "$forgeflow_ready_line"
    forgeflow_ready_line=$forgeflow_trimmed
    forgeflow_update_fence "$forgeflow_ready_line"
    [ "$forgeflow_fence_changed" -eq 0 ] || continue
    [ "$forgeflow_fence_length" -eq 0 ] || continue
    case "$forgeflow_ready_line" in
      '## Goal') forgeflow_ready_section=goal; continue ;;
      '## Scope') forgeflow_ready_section=scope; continue ;;
      '#'|'##'|'# '*|'## '*|"#$forgeflow_tab"*|"##$forgeflow_tab"*)
        forgeflow_ready_section=; continue ;;
      '###'*) continue ;;
    esac
    forgeflow_ready_content "$forgeflow_ready_line" || continue
    case "$forgeflow_ready_section" in
      goal) forgeflow_goal_content=1 ;;
      scope) forgeflow_scope_content=1 ;;
    esac
  done <"$forgeflow_story_file"
  [ "$forgeflow_goal_content" -eq 1 ] ||
    forgeflow_ready_fail '## Goal needs non-placeholder content'
  [ "$forgeflow_scope_content" -eq 1 ] ||
    forgeflow_ready_fail '## Scope needs non-placeholder content'

  forgeflow_ac_ids=' '
  forgeflow_ac_count=0
  forgeflow_fence_length=0
  while IFS= read -r forgeflow_ready_line || [ -n "$forgeflow_ready_line" ]; do
    forgeflow_trim "$forgeflow_ready_line"
    forgeflow_ready_line=$forgeflow_trimmed
    forgeflow_update_fence "$forgeflow_ready_line"
    [ "$forgeflow_fence_changed" -eq 0 ] || continue
    [ "$forgeflow_fence_length" -eq 0 ] || continue
    case "$forgeflow_ready_line" in
      '* '*|'- '*) forgeflow_ready_line=${forgeflow_ready_line#??} ;;
      *) continue ;;
    esac
    case "$forgeflow_ready_line" in
      '[ ] '*|'[x] '*|'[X] '*) forgeflow_ready_line=${forgeflow_ready_line#????} ;;
      *) continue ;;
    esac
    case "$forgeflow_ready_line" in
      AC-*:* ) ;;
      *) continue ;;
    esac
    forgeflow_ac_id=${forgeflow_ready_line%%:*}
    case "${forgeflow_ac_id#AC-}" in
      ''|*[!0-9]*) continue ;;
    esac
    case "$forgeflow_ac_ids" in
      *" $forgeflow_ac_id "*) forgeflow_ready_fail "duplicate AC ID: $forgeflow_ac_id" ;;
    esac
    forgeflow_ac_ids="$forgeflow_ac_ids$forgeflow_ac_id "
    forgeflow_ac_count=$((forgeflow_ac_count + 1))
    forgeflow_ready_content "${forgeflow_ready_line#*:}" ||
      forgeflow_ready_fail "$forgeflow_ac_id needs non-placeholder same-line content"
  done <"$forgeflow_acceptance_file"
  [ "$forgeflow_ac_count" -gt 0 ] ||
    forgeflow_ready_fail 'acceptance.md needs a checkbox AC-<digits>: criterion'
  forgeflow_check_acceptance_evidence
}

forgeflow_check_story() {
  forgeflow_story_directory=$1
  forgeflow_story_label=$forgeflow_story_directory

  forgeflow_story_file="$forgeflow_story_directory/story.md"
  forgeflow_acceptance_file="$forgeflow_story_directory/acceptance.md"

  for forgeflow_required_story_file in \
    "$forgeflow_story_file" "$forgeflow_acceptance_file"
  do
    if [ -L "$forgeflow_required_story_file" ]; then
      printf 'ERROR %s: required Story file is a symlink: %s\n' \
        "$forgeflow_story_label" "$forgeflow_required_story_file" >&2
      forgeflow_operational_error=1
      return
    fi

    if [ ! -f "$forgeflow_required_story_file" ] ||
      [ ! -r "$forgeflow_required_story_file" ] ||
      [ ! -s "$forgeflow_required_story_file" ]; then
      printf 'ERROR %s: required Story file is missing or unreadable: %s\n' \
        "$forgeflow_story_label" "$forgeflow_required_story_file" >&2
      forgeflow_operational_error=1
      return
    fi
  done

  if [ "$forgeflow_ready" -eq 1 ]; then
    forgeflow_check_readiness
  fi

  forgeflow_read_declaration \
    "$forgeflow_story_file" '## Classification' 'Security sensitive'
  forgeflow_security_count=$forgeflow_declaration_count
  forgeflow_security=$forgeflow_declaration_value

  forgeflow_read_declaration \
    "$forgeflow_story_file" '## Classification' 'Baseline conformance'
  forgeflow_baseline_count=$forgeflow_declaration_count
  forgeflow_baseline=$forgeflow_declaration_value

  forgeflow_classification_valid=1

  if [ "$forgeflow_security_count" -ne 1 ]; then
    forgeflow_story_fail 'Classification must declare "Security sensitive" exactly once'
    forgeflow_classification_valid=0
  else
    case "$forgeflow_security" in
      yes|no) ;;
      *)
        forgeflow_story_fail 'Security sensitive must be declared as yes or no'
        forgeflow_classification_valid=0
        ;;
    esac
  fi

  if [ "$forgeflow_baseline_count" -ne 1 ]; then
    forgeflow_story_fail 'Classification must declare "Baseline conformance" exactly once'
    forgeflow_classification_valid=0
  else
    case "$forgeflow_baseline" in
      yes|no) ;;
      *)
        forgeflow_story_fail 'Baseline conformance must be declared as yes or no'
        forgeflow_classification_valid=0
        ;;
    esac
  fi

  if [ "$forgeflow_classification_valid" -eq 0 ]; then
    return
  fi

  forgeflow_check_matrix "$forgeflow_acceptance_file"

  forgeflow_count_literal_bullets \
    "$forgeflow_story_file" '## Trust Boundary Fields'
  forgeflow_trust_found=$forgeflow_bullet_section_found
  forgeflow_trust_total=$forgeflow_bullet_total
  forgeflow_trust_literal=$forgeflow_bullet_literal

  forgeflow_count_literal_bullets \
    "$forgeflow_story_file" '## Superseded Behavior'
  forgeflow_superseded_found=$forgeflow_bullet_section_found
  forgeflow_superseded_total=$forgeflow_bullet_total
  forgeflow_superseded_literal=$forgeflow_bullet_literal

  if [ "$forgeflow_security" = 'yes' ]; then
    if [ "$forgeflow_matrix_found" -eq 0 ]; then
      forgeflow_story_fail 'security-sensitive Story is missing acceptance section: ## Security Fixture Matrix'
    elif [ "$forgeflow_matrix_rows" -eq 0 ]; then
      forgeflow_story_fail 'security fixture matrix declares no fixture rows'
    fi

    if [ "$forgeflow_trust_found" -eq 0 ] ||
      [ "$forgeflow_trust_total" -eq 0 ]; then
      forgeflow_story_fail 'security-sensitive Story must enumerate its trust-boundary fields under ## Trust Boundary Fields'
    elif [ "$forgeflow_trust_literal" -ne "$forgeflow_trust_total" ]; then
      forgeflow_story_fail 'every trust-boundary field must name an exact field, not prose'
    fi
  elif [ "$forgeflow_matrix_found" -eq 1 ]; then
    forgeflow_story_fail 'Story declares Security sensitive: no but provides a security fixture matrix'
  fi

  if [ "$forgeflow_baseline" = 'yes' ]; then
    if [ "$forgeflow_superseded_found" -eq 0 ] ||
      [ "$forgeflow_superseded_total" -eq 0 ]; then
      forgeflow_story_fail 'baseline-conformance Story must list superseded tests or behavior under ## Superseded Behavior'
    elif [ "$forgeflow_superseded_literal" -ne \
      "$forgeflow_superseded_total" ]; then
      forgeflow_story_fail 'every superseded entry must name an exact test path or behavior'
    fi
  elif [ "$forgeflow_superseded_found" -eq 1 ]; then
    forgeflow_story_fail 'Story declares Baseline conformance: no but declares superseded behavior'
  fi

  if [ "$forgeflow_contract_incomplete" -eq "$forgeflow_entry_incomplete" ]; then
    forgeflow_report 'PASS' \
      "classification security=$forgeflow_security baseline=$forgeflow_baseline"
  fi
}

forgeflow_cr=$(printf '\r')
forgeflow_tab=$(printf '\t')
forgeflow_matrix_header_row='| Source field | Payload | Expected result | Persisted locations | Verification |'
forgeflow_evidence_header_row='| AC | Method | Evidence | Fixture / precondition | Expected observation |'
forgeflow_ready=0
if [ "${1-}" = --ready ]; then
  forgeflow_ready=1
  shift
fi

case "${1-}" in
  --help)
    if [ "$#" -ne 1 ] || [ "$forgeflow_ready" -eq 1 ]; then
      usage_error
      exit 2
    fi
    help
    exit 0
    ;;
  -*)
    usage_error
    exit 2
    ;;
esac

forgeflow_contract_incomplete=0
forgeflow_readiness_incomplete=0
forgeflow_operational_error=0
forgeflow_checked=0

printf 'ForgeFlow Story Contract Check\n\n'

if [ "$#" -eq 0 ]; then
  if [ ! -d specs/stories ]; then
    printf 'ERROR Story directory is missing: specs/stories/\n' >&2
    printf '\nResult: ERROR\n'
    printf 'Stories checked: 0\n'
    exit 2
  fi

  for forgeflow_candidate in specs/stories/*
  do
    [ -d "$forgeflow_candidate" ] || continue

    case "$forgeflow_candidate" in
      */_template) continue ;;
    esac

    forgeflow_entry_incomplete=$forgeflow_contract_incomplete
    forgeflow_checked=$((forgeflow_checked + 1))
    forgeflow_check_story "$forgeflow_candidate"
  done
else
  for forgeflow_candidate in "$@"
  do
    case "$forgeflow_candidate" in
      -*) usage_error; exit 2 ;;
    esac
    if [ ! -d "$forgeflow_candidate" ]; then
      printf 'ERROR Story directory is missing: %s\n' \
        "$forgeflow_candidate" >&2
      forgeflow_operational_error=1
      continue
    fi

    forgeflow_entry_incomplete=$forgeflow_contract_incomplete
    forgeflow_checked=$((forgeflow_checked + 1))
    forgeflow_check_story "$forgeflow_candidate"
  done
fi

printf '\n'

if [ "$forgeflow_operational_error" -eq 1 ]; then
  printf 'Result: ERROR\n'
  printf 'Stories checked: %s\n' "$forgeflow_checked"
  exit 2
fi

if [ "$forgeflow_checked" -eq 0 ]; then
  printf 'ERROR No Story directory was checked\n' >&2
  printf 'Result: ERROR\n'
  printf 'Stories checked: 0\n'
  exit 2
fi

if [ "$forgeflow_ready" -eq 1 ]; then
  if [ "$forgeflow_contract_incomplete" -gt 0 ]; then
    printf 'Structure: STORY_CONTRACT_INCOMPLETE\n'
  else
    printf 'Structure: STORY_CONTRACT_OK\n'
  fi
  if [ "$forgeflow_contract_incomplete" -gt 0 ] ||
    [ "$forgeflow_readiness_incomplete" -gt 0 ]; then
    printf 'Result: STORY_READINESS_INCOMPLETE\n'
    printf 'Stories checked: %s\n' "$forgeflow_checked"
    printf 'Fill the reported structure or minimum content, then recheck.\n'
    exit 1
  fi
  printf 'Result: STORY_READINESS_OK\n'
  printf 'Stories checked: %s\n' "$forgeflow_checked"
  printf 'Minimum content only, not human-approved READY. Run make verify and human review.\n'
  exit 0
fi

if [ "$forgeflow_contract_incomplete" -gt 0 ]; then
  printf 'Result: STORY_CONTRACT_INCOMPLETE\n'
  printf 'Stories checked: %s\n\n' "$forgeflow_checked"
  printf 'Next:\n'
  printf 'Record the missing classification, fixture matrix, or superseded\n'
  printf 'behavior in the Story, then run this check again.\n'
  exit 1
fi

printf 'Result: STORY_CONTRACT_OK\n'
printf 'Stories checked: %s\n\n' "$forgeflow_checked"
printf 'Next:\n'
printf 'Static Story structure only. Run make verify and human review.\n'
