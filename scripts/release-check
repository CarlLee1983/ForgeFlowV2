#!/bin/sh

set -eu

GIT_OPTIONAL_LOCKS=0
GIT_NO_LAZY_FETCH=1
GIT_NO_REPLACE_OBJECTS=1
export GIT_OPTIONAL_LOCKS GIT_NO_LAZY_FETCH GIT_NO_REPLACE_OBJECTS

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

fail() {
  printf 'release check failed: %s\n' "$1" >&2
  exit 1
}

if [ "$#" -ne 0 ]; then
  printf 'release check failed: release-check takes no arguments\n' >&2
  exit 2
fi

release_repo=$(
  CDPATH='' cd -P -- "$(dirname -- "$0")/.." >/dev/null 2>&1
  pwd
)
release_version_file="$release_repo/VERSION"

if ! release_git_root=$(
  GIT_OPTIONAL_LOCKS=0 git -C "$release_repo" rev-parse --show-toplevel \
    2>/dev/null
); then
  fail 'repository is not a Git worktree'
fi

release_git_root=$(
  CDPATH='' cd -P -- "$release_git_root" >/dev/null 2>&1
  pwd
)

if [ "$release_git_root" != "$release_repo" ]; then
  fail 'release-check is not installed at the repository root'
fi

if ! release_head=$(
  git -C "$release_repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null
); then
  fail 'HEAD does not resolve to a commit'
fi

if ! release_hidden_index_entries=$(
  git -c core.fsmonitor=false -C "$release_repo" ls-files -v
); then
  fail 'could not inspect index flags'
fi

if printf '%s\n' "$release_hidden_index_entries" | grep -Eq '^[a-zS] '; then
  fail 'index contains assume-unchanged or skip-worktree entries'
fi

if ! release_head_version_object=$(
  git -C "$release_repo" rev-parse --verify 'HEAD:VERSION' 2>/dev/null
); then
  fail 'VERSION is not committed at HEAD'
fi

if [ "$(git -C "$release_repo" cat-file -t "$release_head_version_object" 2>/dev/null || true)" != 'blob' ]; then
  fail 'committed VERSION is not a file'
fi

if [ ! -f "$release_version_file" ] ||
  ! release_worktree_version_object=$(
    git -C "$release_repo" hash-object --no-filters "$release_version_file" \
      2>/dev/null
  ) || [ "$release_worktree_version_object" != "$release_head_version_object" ]; then
  fail 'working VERSION does not match committed HEAD'
fi

if ! release_version_size=$(
  git -C "$release_repo" cat-file -s "$release_head_version_object" 2>/dev/null
) || ! release_version=$(
  git -C "$release_repo" cat-file blob "$release_head_version_object" 2>/dev/null
); then
  fail 'could not read committed VERSION'
fi

release_expected_version_size=$((${#release_version} + 1))
release_version_record_count=$(
  printf '%s\n' "$release_version" | wc -l | tr -d '[:space:]'
)

if [ "$release_version_size" -ne "$release_expected_version_size" ] ||
  [ "$release_version_record_count" -ne 1 ] ||
  ! printf '%s\n' "$release_version" |
    grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
  fail 'VERSION must contain one MAJOR.MINOR.PATCH value'
fi

release_expected_tag="v$release_version"

if ! release_status=$(
  git -c core.fsmonitor=false -C "$release_repo" status \
    --porcelain=v1 --untracked-files=all --ignore-submodules=none
); then
  fail 'could not inspect worktree state'
fi

if [ -n "$release_status" ]; then
  printf '%s\n' "$release_status" >&2
  fail 'worktree is not clean'
fi

if ! release_tag_snapshot=$(
  git -C "$release_repo" for-each-ref \
    --format='%(refname) %(objectname)' refs/tags
); then
  fail 'could not inspect local tags'
fi

release_tag_status=0
git -C "$release_repo" show-ref --verify --quiet \
  "refs/tags/$release_expected_tag" || release_tag_status=$?

case "$release_tag_status" in
  0)
    if ! release_tag_commit=$(
      git -C "$release_repo" rev-parse --verify \
        "refs/tags/$release_expected_tag^{commit}" 2>/dev/null
    ); then
      fail 'expected tag does not resolve to a commit'
    fi

    if [ "$release_tag_commit" != "$release_head" ]; then
      fail 'expected tag does not resolve to HEAD'
    fi

    release_local_tag_state='same-head'
    ;;
  1)
    release_local_tag_state='absent'
    ;;
  *)
    fail 'could not inspect expected local tag'
    ;;
esac

if ! release_local_tag_refs=$(
  git -C "$release_repo" for-each-ref --format='%(refname)' refs/tags
); then
  fail 'could not inspect local tags'
fi

for release_local_tag_ref in $release_local_tag_refs
do
  case "$release_local_tag_ref" in
    refs/tags/*)
      release_local_tag=${release_local_tag_ref#refs/tags/}
      ;;
    *)
      fail 'local tag enumeration returned an invalid ref'
      ;;
  esac

  if [ "$release_local_tag" = "$release_expected_tag" ] ||
    ! printf '%s\n' "$release_local_tag" |
      grep -Eq '^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
    continue
  fi

  if release_other_tag_commit=$(
    git -C "$release_repo" rev-parse --verify \
      "refs/tags/$release_local_tag^{commit}" 2>/dev/null
  ) && [ "$release_other_tag_commit" = "$release_head" ]; then
    fail "different release tag points to HEAD: $release_local_tag"
  fi
done

if ! release_final_head=$(
  git -C "$release_repo" rev-parse --verify 'HEAD^{commit}' 2>/dev/null
); then
  fail 'HEAD changed during release check'
fi

if [ "$release_final_head" != "$release_head" ]; then
  fail 'HEAD changed during release check'
fi

if ! release_final_tag_snapshot=$(
  git -C "$release_repo" for-each-ref \
    --format='%(refname) %(objectname)' refs/tags
); then
  fail 'could not recheck local tags'
fi

if [ "$release_final_tag_snapshot" != "$release_tag_snapshot" ]; then
  fail 'local tags changed during release check'
fi

if ! release_final_hidden_index_entries=$(
  git -c core.fsmonitor=false -C "$release_repo" ls-files -v
); then
  fail 'could not recheck index flags'
fi

if [ "$release_final_hidden_index_entries" != "$release_hidden_index_entries" ] ||
  printf '%s\n' "$release_final_hidden_index_entries" |
    grep -Eq '^[a-zS] '; then
  fail 'index flags changed during release check'
fi

if ! release_final_worktree_version_object=$(
  git -C "$release_repo" hash-object --no-filters "$release_version_file" \
    2>/dev/null
) || [ "$release_final_worktree_version_object" != "$release_head_version_object" ]; then
  fail 'working VERSION changed during release check'
fi

if ! release_final_status=$(
  git -c core.fsmonitor=false -C "$release_repo" status \
    --porcelain=v1 --untracked-files=all --ignore-submodules=none
); then
  fail 'could not recheck worktree state'
fi

if [ -n "$release_final_status" ]; then
  printf '%s\n' "$release_final_status" >&2
  fail 'worktree changed during release check'
fi

printf 'release check passed\n'
printf 'version=%s\n' "$release_version"
printf 'commit=%s\n' "$release_head"
printf 'expected_tag=%s\n' "$release_expected_tag"
printf 'local_tag=%s\n' "$release_local_tag_state"
printf 'remote_checks=not-performed\n'
