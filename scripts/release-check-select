#!/bin/sh

set -eu

if [ "$#" -ne 0 ]; then
  printf 'release check failed: selector takes no arguments\n' >&2
  exit 2
fi

release_select_root=$(
  CDPATH='' cd -P "$(dirname "$0")/.." >/dev/null 2>&1
  pwd
)

case ${RELEASE_CHECK_IMPLEMENTATION:-typescript} in
  typescript)
    exec node "$release_select_root/scripts/release-check-compat.mjs"
    ;;
  legacy)
    exec "$release_select_root/scripts/release-check"
    ;;
  *)
    printf 'release check failed: unknown implementation\n' >&2
    exit 2
    ;;
esac
