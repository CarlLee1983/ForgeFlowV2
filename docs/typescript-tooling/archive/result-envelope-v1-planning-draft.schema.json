{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeflow:cli-result:1",
  "title": "ForgeFlow CLI Result Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "command",
    "status",
    "outcome",
    "exitCode",
    "issues",
    "evidence",
    "error",
    "data",
    "metadata"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$"
    },
    "status": {
      "enum": ["pass", "fail", "error"]
    },
    "outcome": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "exitCode": {
      "enum": [0, 1, 2, 3]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "error": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/toolError" }]
    },
    "data": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "pass" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "exitCode": { "const": 0 },
          "error": { "type": "null" },
          "issues": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/$defs/issue" },
                {
                  "properties": { "severity": { "const": "warning" } }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "fail" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "exitCode": { "const": 1 },
          "error": { "type": "null" },
          "issues": {
            "type": "array",
            "minItems": 1,
            "contains": {
              "allOf": [
                { "$ref": "#/$defs/issue" },
                {
                  "properties": { "severity": { "const": "error" } }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "error" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "outcome": { "const": "ERROR" },
          "exitCode": { "enum": [2, 3] },
          "error": { "$ref": "#/$defs/toolError" }
        }
      }
    },
    {
      "if": {
        "properties": { "exitCode": { "const": 3 } },
        "required": ["exitCode"]
      },
      "then": {
        "properties": {
          "error": {
            "allOf": [
              { "$ref": "#/$defs/toolError" },
              {
                "properties": { "category": { "const": "internal" } }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error": {
            "type": "object",
            "properties": { "category": { "const": "internal" } },
            "required": ["category"]
          }
        },
        "required": ["error"]
      },
      "then": {
        "properties": { "exitCode": { "const": 3 } }
      }
    }
  ],
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.?($|/))(?!.*\\/\\.\\.?($|/))(?!.*//)(?!.*\\/$)(?!.*\\\\)[^\\u0000-\\u001F\\u007F]+$"
    },
    "stableSubject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)[^\\u0000-\\u001F\\u007F]+$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "category", "message", "data"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "severity": {
          "enum": ["warning", "error"]
        },
        "category": {
          "enum": [
            "protocol",
            "validation",
            "evidence",
            "compatibility",
            "safety",
            "configuration",
            "environment",
            "internal"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "data": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "kind", "subject", "status", "observation"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "kind": {
          "enum": [
            "file",
            "declaration",
            "command",
            "git",
            "mutation",
            "version"
          ]
        },
        "subject": {
          "$ref": "#/$defs/stableSubject"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "partial",
            "not_run",
            "not_checked",
            "unsupported",
            "unknown"
          ]
        },
        "observation": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "toolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "message", "retryable", "data"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "category": {
          "enum": ["usage", "configuration", "environment", "internal"]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "data": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolingVersion",
        "protocolVersion",
        "supportedProtocolRange"
      ],
      "properties": {
        "toolingVersion": {
          "$ref": "#/$defs/semver"
        },
        "protocolVersion": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/semver" }]
        },
        "supportedProtocolRange": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?=.*(?:[0-9*Xx]))[0-9A-Za-z.*+<>=~^| -]+$",
          "format": "forgeflow-npm-semver-range"
        }
      }
    }
  }
}
